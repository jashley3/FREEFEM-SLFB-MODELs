#Curvature
def k(a1):
    return abs(d2Iapp(a1))/((1+(dIapp(a1))**2)**1.5)


dtmaxglobal=5 #Must be selected such that it isn't big enough to jump any sharp gaps. Don't want it too small or else the breakpoints will take longer to compute.
dtmax=dtmaxglobal
dtmin=5e-4 #Must be selected to reflect the smallest timescale of Iapp(t)
cor=1e-6;

t=0
dt=dtmin

breakpoints=[0]

tol=0.1#0.5
while t < Tfinal:

    dt=dt+dtmin
   
    if (dt>dtmax):
        dt=dt-dtmin
        
    er=abs((dIapp(t) - ((Iapp(t) - Iapp(t + dt))/(t-(t + dt))))/(dIapp(t) + cor))
    if (er>tol): 
        while(er>tol):
            dt=dt*0.5#-dtmin
            er=abs((dIapp(t) - ((Iapp(t) - Iapp(t + dt))/(t-(t + dt))))/(dIapp(t) + cor))
            if (dt<dtmin):
                dt=dtmin
                break
        
    t=t+dt
    breakpoints.append(t)
    #print(t)
    if t>Tfinal:
        break

  
breakpoints = np.array(breakpoints)



t = breakpoints       
f = k(breakpoints )
peaks, _ = find_peaks(f)


idx = np.concatenate([peaks])
#idx = np.concatenate([peaks - 1, peaks, peaks + 1])
idx = idx[(idx >= 0) & (idx < len(breakpoints ))]
idx_unique = np.unique(idx)
t_final = breakpoints [idx_unique]
t_final=np.insert(t_final,0,0)





