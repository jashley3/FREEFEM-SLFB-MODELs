    return (-0.6*(2*np.pi/300)**2*np.sin(2*np.pi*a1/300)-0.3*(2*np.pi/75)**2*np.sin(2*np.pi*a1/75 + 1)-0.1*(2*np.pi/20)**2*np.sin(2*np.pi*a1/20 + 2))
