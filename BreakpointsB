#Messy Iapp(t)

Tfinal=300
def Iapp(a1):
    return 2 + 0.6*np.sin(2*np.pi*a1/300) + 0.3*np.sin(2*np.pi*a1/75 + 1) + 0.1*np.sin(2*np.pi*a1/20 + 2)

