plt.scatter(t_final, Iapp(t_final), color='red', s=20, label='Breakpoints')

plt.ylabel("$I_{app}(t)$",fontsize="19")
plt.legend(fontsize="15")
plt.title("Breakpoint Computation",fontsize=15)
plt.tight_layout()
plt.xlabel("$Time$ (s)",fontsize="15")
plt.tick_params(axis='both', labelsize=14)
