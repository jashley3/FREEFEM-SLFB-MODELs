M23FE=M23(uin1,uin2); M23du1FE=M23du1(uin1,uin2); M23du2FE=M23du2(uin1,uin2);
M22FE=M22(uin1,uin2); M22du1FE=M22du1(uin1,uin2); M22du2FE=M22du2(uin1,uin2);
M33FE=M33(uin1,uin2); M33du1FE=M33du1(uin1,uin2); M33du2FE=M33du2(uin1,uin2);

Denom2FE=Denom2(uni1,uni2); Denom2du1FE=Denom2du1(uni1,uni2); Denom2du2FE=Denom2du2(uni1,uni2);

L11FE=L11(uni1,uin2); L11du1FE=L11du1(uin1,uin2); L11du2FE=L11du2(uin1,uin2);
L12FE=L12(uin1,uin2); L12du1FE=L12du1(uin1,uin2); L12du2FE=L12du2(uin1,uin2);
L13FE=L13(uni1,uin2); L13du1FE=L13du1(uin1,uin2); L13du2FE=L13du2(uin1,uin2);
L23FE=L23(uin1,uin2); L23du1FE=L23du1(uin1,uin2); L23du2FE=L23du2(uin1,uin2);
L22FE=L22(uin1,uin2); L22du1FE=L22du1(uin1,uin2); L22du2FE=L22du2(uin1,uin2);
L33FE=L33(uin1,uin2); L33du1FE=L33du1(uin1,uin2); L33du2FE=L33du2(uin1,uin2);

kappaFE=kappa(uin1,uin2);

kappavalsA.resize(m+2);
kappavalsA[m+1]=(1/(L*W))*int2d(dom4)(kappa(u1,u2)); //(1/L)*int1d(dom4,4)(kappa(u1,u2));//(1/W)*int1d(dom4,3)(kappaFE);


D10valsA.resize(m+2);
D10valsA[m+1]=(1/(L*W))*int2d(dom4)(R*T*u1/D10(u1,u2)); 

D20valsA.resize(m+2);
D20valsA[m+1]=(1/(L*W))*int2d(dom4)(R*T*u2/D20(u1,u2)); 

D30valsA.resize(m+2);
D30valsA[m+1]=(1/(L*W))*int2d(dom4)(R*T*(2*u1+u2)/D30(u1,u2)); 

D12valsA.resize(m+2);
D12valsA[m+1]=(1/(L*W))*int2d(dom4)(R*T*u1*u2/(55308*D12(u1,u2))); 

D13valsA.resize(m+2);
D13valsA[m+1]=(1/(L*W))*int2d(dom4)(R*T*u1*(2*u1+u2)/(55308*D13(u1,u2))); 

D23valsA.resize(m+2);
D23valsA[m+1]=(1/(L*W))*int2d(dom4)(R*T*u2*(2*u1+u2)/(55308*D23(u1,u2))); 


t1vals.resize(m+2);
t1vals[m+1]=(1/(L*W))*int2d(dom4)( ((z1*u1*F^2)/kappa(u1,u2))*( z1*u1*L11(u1,u2) + z2*u2*L12(u1,u2) + z3*(2*u1+u2)*L13(u1,u2) ) ); 

t2vals.resize(m+2);
t2vals[m+1]=(1/(L*W))*int2d(dom4)( ((z2*u2*F^2)/kappa(u1,u2))*( z1*u1*L12(u1,u2) + z2*u2*L22(u1,u2) + z3*(2*u1+u2)*L23(u1,u2) ) ); 

t3vals.resize(m+2);
t3vals[m+1]=(1/(L*W))*int2d(dom4)( ((z3*(2*u1+u2)*F^2)/kappa(u1,u2))*( z1*u1*L13(u1,u2) + z2*u2*L23(u1,u2) + z3*(2*u1+u2)*L33(u1,u2) ) ); 






real dvoltErr;

int mcount=0;

int mRestart=0;

int iBP=0;

int restartNum=0;





ofstream VOLTfile("voltvals1.txt"); //.txt
ofstream Timefile("timevals1.txt");
ofstream C1normfile("c1norm.txt"); //.txt
ofstream C2normfile("c2norm.txt"); //.txt
ofstream phinormfile("phinorm.txt"); //.txt
ofstream outint1file("outint1.txt"); //.txt
ofstream dvoltErrfile("dvoltErr.txt"); //.txt
ofstream itotvalsfile("itotvals1.txt");
