        itot=i;



        real Lu1= u1[].linfty, Lu2=u2[].linfty, Lphi=phi[].linfty;
        err1 = du1[].linfty/(Lu1) + du2[].linfty/(Lu2) + dphi[].linfty/(Lphi);

        

        if(isNaN(err1)==1){

