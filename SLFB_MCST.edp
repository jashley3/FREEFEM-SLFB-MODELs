            u1=U1[U1.n-1]; u2=U2[U2.n-1]; phi=PHI[PHI.n-1]; VOLT=voltvals[voltvals.n-1]; Cpb=CPB[Nstore-1]; CbpbO2=CPBO2[Nstore-1]; CpbO=CPBO[Nstore-1];           
        }

        if(KcancelSim==1) break;
        if(K2==1) break;


        if(i==0){
            errvals.resize(m+2);
            errvals[m+1] = err1;

        }
        cout<<"- - -"<<endl;
        cout<<i<<"err="<<err1<<endl;
        cout<<"- - -"<<endl;
        
    }

    
    if(KcancelSim==1) break;
    
    if(m>2 && K2==0){

        if(itot>1){
            dvoltErr = abs((((VOLT - voltvals[voltvals.n-1])/(t - timevals[timevals.n-1])) - ((voltvals[voltvals.n-1] - voltvals[voltvals.n-2])/(timevals[timevals.n-1] - timevals[timevals.n-2])))/(1e-20 + ((voltvals[voltvals.n-1] - voltvals[voltvals.n-2])/(timevals[timevals.n-1] - timevals[timevals.n-2]))));
            

            
            if(dvoltErr>0.4 && dt>dtmin && itot>5){
                DT=DT/stepsizeratio;
                if(DT<dtmin){
                    DT=dtmin;
                }

                mcount=MC;

                
            }
           
            if(dvoltErr<=0.3  && mcount==0){ 
                DT=DT*stepsizeratio;  
                if(DT>dtmax){  
                    DT=dtmax;
                }
            }
        }


        
        if(itot<=5){
            DT=DT*2;
            if(DT>dtmax){
                DT=dtmax;
            }
        }


       
    }

   

    if(K2==0){

        dt=DT;

        if(mcount>0){
            mcount=mcount-1;
        }

        if(mRestart>0){
            mRestart=mRestart-1;
        }

        


        Vh4bound CpbWall2ver2 = Cpb; //interpolates Cpb calculated above onto wall2 only      
        
        real sumCpb=0;
        for(int iii=0; iii<=(Vh4bound.ndof -1); iii++){
            sumCpb+=CpbWall2ver2[][iii];
        }
        real CpbAv=(sumCpb)/(Vh4bound.ndof);
        cout<<"----"<<endl;
        cout<<"Average cumulative Pb concentration="<<CpbAv<<endl;
        cout<<"----"<<endl;



        

        Vh4ver2bound CbpbO2Wall1ver2 = CbpbO2;
        Vh4ver2bound CpbOWall1 = CpbO;


        real sumbCpbO2=0;
        for(int iii=0; iii<=(Vh4ver2bound.ndof -1); iii++){
