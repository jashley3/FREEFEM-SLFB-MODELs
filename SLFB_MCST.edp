//Initial conditions: concentrations of all species are uniform in space

real t=0; //Initialise time



u1=u1initial;  //Initial value for Newt. iteration (initial guess. In this case, we simply take it to be the value of the solution at t=0.)
uin1=u1[].max;
U1[Nstore-1]=u1;
U1[Nstore-2]=u1;
U1[Nstore-3]=u1;
UIN1[Nstore-1]=u1;
UIN1[Nstore-2]=u1;
UIN1[Nstore-3]=u1;


u2=u2initial;
uin2=u2[].max;
U2[Nstore-1]=u2;
U2[Nstore-2]=u2;
U2[Nstore-3]=u2;
UIN2[Nstore-1]=u2;
UIN2[Nstore-2]=u2;
UIN2[Nstore-3]=u2;


phi=phiguess; //starting guess for phi in Newt iteration/initial value for phi   
PHI[Nstore-1]=phi;
PHI[Nstore-2]=phi;
PHI[Nstore-3]=phi;


//Start with bare electrodes
Cpb=Cpbinitial;   
CPB[Nstore-1]=Cpb;
CPB[Nstore-2]=Cpb;
