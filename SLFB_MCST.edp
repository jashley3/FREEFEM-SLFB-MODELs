D10FE=D10(uin1,uin2); D10du1FE=D10du1(uin1,uin2); D10du2FE=D10du2(uin1,uin2);
D12FE=D12(uin1,uin2); D12du1FE=D12du1(uin1,uin2); D12du2FE=D12du2(uin1,uin2);
D13FE=D13(uin1,uin2); D13du1FE=D13du1(uin1,uin2); D13du2FE=D13du2(uin1,uin2);
D23FE=D23(uin1,uin2); D23du1FE=D23du1(uin1,uin2); D23du2FE=D23du2(uin1,uin2);
