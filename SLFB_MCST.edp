macro M33(a1, a2) ((R*T/cT(a1,a2))*(-((2*(a1+epsilon)+(a2+epsilon))*c0(a1,a2)/D30FE)-((a1+epsilon)*(2*(a1+epsilon)+(a2+epsilon))/D13FE)-((a2+epsilon)*(2*(a1+epsilon)+(a2+epsilon))/D23FE))) // //CHECKED
macro M33du1(a1, a2) ((1/(cT(a1,a2))^2)*R*T*((((2*a1+a2+3*epsilon)*(c0(a1,a2)*D13FE*D23FE+((a2+epsilon)*D13FE+(a1+epsilon)*D23FE)*D30FE)*cTdu1(a1,a2))/(D13FE*D23FE*D30FE))+cT(a1,a2)*(-((2*(a1+epsilon))/(D13FE))-((2*a1+a2+3*epsilon)/(D13FE))-((2*(a2+epsilon))/(D23FE))-((2*c0(a1,a2))/(D30FE))-(((2*a1+a2+3*epsilon)*c0du1(a1,a2))/(D30FE)) + (((a1+epsilon)*(2*a1+a2+3*epsilon)*D13du1FE)/(D13FE)^2) + (((a2+epsilon)*(2*a1+a2+3*epsilon)*D23du1FE)/(D23FE)^2) + (((2*a1+a2+3*epsilon)*c0(a1,a2)*D30du1FE)/(D30FE)^2)))) // //CHECKED
macro M33du2(a1, a2) ((1/(cT(a1,a2))^2)*R*T*((((2*a1+a2+3*epsilon)*(c0(a1,a2)*D13FE*D23FE+((a2+epsilon)*D13FE+(a1+epsilon)*D23FE)*D30FE)*cTdu2(a1,a2))/(D13FE*D23FE*D30FE))+cT(a1,a2)*(-((a1+epsilon)/(D13FE))-((a2+epsilon)/(D23FE))-((2*a1+a2+3*epsilon)/(D23FE))-((c0(a1,a2))/(D30FE))-(((2*a1+a2+3*epsilon)*c0du2(a1,a2))/(D30FE))+(((a1+epsilon)*(2*a1+a2+3*epsilon)*D13du2FE)/(D13FE)^2) + (((a2+epsilon)*(2*a1+a2+3*epsilon)*D23du2FE)/(D23FE)^2) + (((2*a1+a2+3*epsilon)*c0(a1,a2)*D30du2FE)/(D30FE)^2)))) // //CHECKED


macro M12(a1, a2) ((R*T/cT(a1,a2))*((a1+epsilon)*(a2+epsilon)/D12FE)) // //CHECKED
macro M12du1(a1, a2) ((((a2+epsilon)*R*T)/(cT(a1,a2)*D12FE))-(((a1+epsilon)*(a2+epsilon)*R*T*cTdu1(a1,a2))/((cT(a1,a2))^2*D12FE))-(((a1+epsilon)*(a2+epsilon)*R*T*D12du1FE)/(cT(a1,a2)*(D12FE)^2))) // //CHECKED
macro M12du2(a1, a2) ((((a1+epsilon)*R*T)/(cT(a1,a2)*D12FE))-(((a1+epsilon)*(a2+epsilon)*R*T*cTdu2(a1,a2))/((cT(a1,a2))^2*D12FE))-(((a1+epsilon)*(a2+epsilon)*R*T*D12du2FE)/(cT(a1,a2)*(D12FE)^2))) // //CHECKED


macro Denom2(a1, a2) ((-M13FE*M13FE*M22FE) + (2*M12FE*M13FE*M23FE) - (M11FE*M23FE*M23FE) - (M12FE*M12FE*M33FE) + (M11FE*M22FE*M33FE)) //  //CHECKED
macro Denom2du1(a1, a2) (-(M23FE)^2*M11du1FE+M22FE*M33FE*M11du1FE+2*M13FE*M23FE*M12du1FE-2*M12FE*M33FE*M12du1FE-2*M13FE*M22FE*M13du1FE+2*M12FE*M23FE*M13du1FE-(M13FE)^2*M22du1FE+M11FE*M33FE*M22du1FE+2*M12FE*M13FE*M23du1FE-2*M11FE*M23FE*M23du1FE-(M12FE)^2*M33du1FE+M11FE*M22FE*M33du1FE) // //CHECKED
macro Denom2du2(a1, a2) (-(M23FE)^2*M11du2FE+M22FE*M33FE*M11du2FE+2*M13FE*M23FE*M12du2FE-2*M12FE*M33FE*M12du2FE-2*M13FE*M22FE*M13du2FE+2*M12FE*M23FE*M13du2FE-(M13FE)^2*M22du2FE+M11FE*M33FE*M22du2FE+2*M12FE*M13FE*M23du2FE-2*M11FE*M23FE*M23du2FE-(M12FE)^2*M33du2FE+M11FE*M22FE*M33du2FE) // //CHECKED


macro L11(a1, a2) (-(1/Denom2FE)*(-(M23FE)^2+M22FE*M33FE)) // //CHECKED
macro L11du1(a1, a2) ((((-(M23FE)^2+M22FE*M33FE)*Denom2du1FE)/(Denom2FE)^2) - ((M33FE*M22du1FE-2*M23FE*M23du1FE+M22FE*M33du1FE)/(Denom2FE))) // //CHECKED
macro L11du2(a1, a2) ((((-(M23FE)^2+M22FE*M33FE)*Denom2du2FE)/(Denom2FE)^2) - ((M33FE*M22du2FE-2*M23FE*M23du2FE+M22FE*M33du2FE)/(Denom2FE))) // //CHECKED


macro L22(a1, a2) (-(1/Denom2FE)*(-(M13FE)^2+M11FE*M33FE)) // //CHECKED
macro L22du1(a1, a2) ((((-(M13FE)^2+M11FE*M33FE)*Denom2du1FE)/(Denom2FE)^2) - ((M33FE*M11du1FE-2*M13FE*M13du1FE+M11FE*M33du1FE)/(Denom2FE))) // //CHECKED
macro L22du2(a1, a2) ((((-(M13FE)^2+M11FE*M33FE)*Denom2du2FE)/(Denom2FE)^2) - ((M33FE*M11du2FE-2*M13FE*M13du2FE+M11FE*M33du2FE)/(Denom2FE))) // //CHECKED


macro L33(a1, a2) (-(1/Denom2FE)*(-(M12FE)^2+M11FE*M22FE)) // //CHECKED
macro L33du1(a1, a2) ((((-(M12FE)^2+M11FE*M22FE)*Denom2du1FE)/(Denom2FE)^2) - ((M22FE*M11du1FE-2*M12FE*M12du1FE+M11FE*M22du1FE)/(Denom2FE))) // //CHECKED
macro L33du2(a1, a2) ((((-(M12FE)^2+M11FE*M22FE)*Denom2du2FE)/(Denom2FE)^2) - ((M22FE*M11du2FE-2*M12FE*M12du2FE+M11FE*M22du2FE)/(Denom2FE))) // //CHECKED


macro L12(a1, a2) (-(1/Denom2FE)*(M13FE*M23FE-M12FE*M33FE)) // //CHECKED
macro L12du1(a1, a2) ((((M13FE*M23FE-M12FE*M33FE)*Denom2du1FE)/(Denom2FE)^2) - ((-M33FE*M12du1FE+M23FE*M13du1FE+M13FE*M23du1FE-M12FE*M33du1FE)/(Denom2FE))) // //CHECKED
macro L12du2(a1, a2) ((((M13FE*M23FE-M12FE*M33FE)*Denom2du2FE)/(Denom2FE)^2) - ((-M33FE*M12du2FE+M23FE*M13du2FE+M13FE*M23du2FE-M12FE*M33du2FE)/(Denom2FE))) // //CHECKED


macro L13(a1, a2) (-(1/Denom2FE)*(-M13FE*M22FE+M12FE*M23FE)) // //CHECKED
macro L13du1(a1, a2) ((((-M13FE*M22FE+M12FE*M23FE)*Denom2du1FE)/(Denom2FE)^2) - ((M23FE*M12du1FE-M22FE*M13du1FE-M13FE*M22du1FE+M12FE*M23du1FE)/(Denom2FE))) // //CHECKED
macro L13du2(a1, a2) ((((-M13FE*M22FE+M12FE*M23FE)*Denom2du2FE)/(Denom2FE)^2) - ((M23FE*M12du2FE-M22FE*M13du2FE-M13FE*M22du2FE+M12FE*M23du2FE)/(Denom2FE))) // //CHECKED


macro L23(a1, a2) (-(1/Denom2FE)*(M12FE*M13FE-M11FE*M23FE)) // //CHECKED
macro L23du1(a1, a2) ((((M12FE*M13FE-M11FE*M23FE)*Denom2du1FE)/(Denom2FE)^2) - ((-M23FE*M11du1FE+M13FE*M12du1FE+M12FE*M13du1FE-M11FE*M23du1FE)/(Denom2FE))) // //CHECKED
macro L23du2(a1, a2) ((((M12FE*M13FE-M11FE*M23FE)*Denom2du2FE)/(Denom2FE)^2) - ((-M23FE*M11du2FE+M13FE*M12du2FE+M12FE*M13du2FE-M11FE*M23du2FE)/(Denom2FE))) // //CHECKED



macro kappa(a1,a2) ( F^2*(L11FE*(z1*a1)^2 + L22FE*(z2*a2)^2 + L33FE*(-z1*a1-z2*a2)^2 + 2*L12FE*z1*a1*z2*a2 + 2*L13FE*z1*a1*(-z1*a1-z2*a2) + 2*L23FE*z2*a2*(-z1*a1-z2*a2)) ) //





int Nstore=5; //The number of most recent solutions the solver will store

Vh U1[Nstore];

Vh2 U2[Nstore];

Vh3 PHI[Nstore];

Vh4ver2bound CPBO2[Nstore], CPBO[Nstore];

Vh4bound CPB[Nstore];

real[int] UIN1(Nstore);
real[int] UIN2(Nstore);




//Define arrays for the quantities of interest
real[int] timevals; 
real[int] voltvals;
real[int] CpbAvVals;
real[int] CbpbO2AvVals;
real[int] CpbOAvVals;
real[int] itotvals; 
real[int] errvals; 
real[int] uin1AvVals;
real[int] uin2AvVals;
real[int] dvoltErrvals;
real[int] outintvals1;
real[int] outintvals2;
real[int] c1normvals;
real[int] c2normvals;
real[int] phinormvals;
real[int] kappavalsA;
real[int] D10valsA;
real[int] D20valsA;
real[int] D30valsA;
real[int] D12valsA;
real[int] D13valsA;
real[int] D23valsA;
real[int] t1vals;
real[int] t2vals;
real[int] t3vals;



//Macros for the Butler-Volmer expressions and their derivatives:
//WHERE phiminus=-VOLT/2 and phiplus=VOLT/2

//a1=y   Place this in front of all macros for the Butler-VOlmers and their derivatives if smoothing is wanted near the inlet and outlet (transition to zero across a distance of 1mm)
macro smoother(a1) ((0.5+0.5*tanh(1e4*(a1-0.0005)))-(0.5+0.5*tanh(1e4*(a1-0.0995)))) //



//a1=u1, a2=phi, a3=Cpb jpb(u1,phi,Cpb)
macro jpb(a1,a2,a3) (2*F*k0pb*((0.5+0.5*tanh(k*(a3-DELTA)))*exp((((2-alphaCpb)*F)/(R*T))*(-(VOLT/2)-a2-Eminus))-(a1/u1theta)*exp(-((alphaCpb*F)/(R*T))*(-(VOLT/2)-a2-Eminus)))) //


//a1=phi
macro jpbdu1(a1) (-2*F*k0pb*(1/u1theta)*exp(-((alphaCpb*F)/(R*T))*(-(VOLT/2)-a1-Eminus))) //


//a1=u1, a2=phi, a3=Cpb jpb(u1,phi,Cpb)
macro jpbdphi(a1,a2,a3) (-2*F*k0pb*((0.5+0.5*tanh(k*(a3-DELTA)))*(((2-alphaCpb)*F)/(R*T))*exp((((2-alphaCpb)*F)/(R*T))*(-(VOLT/2)-a2-Eminus)) + (a1/u1theta)*((alphaCpb*F)/(R*T))*exp(-((alphaCpb*F)/(R*T))*(-(VOLT/2)-a2-Eminus)))) //




//a1=u1, a2=phi, a3=VOLT, Spbo2=CbpbO2, Spbo=CpbO, a6=u2   ---   jpbO2(u1,phi,VOLT,CbpbO2,CpbO,u2)
macro jpbO2(a1,a2,a3,Spbo2,Spbo,a6) (2*F*k0BETApb02*((a1/u1theta)*exp((((2-alphaCBETApbo2)*F)/(R*T))*(a3/2-a2-Ebeta1))-(Spbo2/(Spbo2+Spbo+1e-90))*((a6/u2theta)^4)*exp(-((alphaCBETApbo2*F)/(R*T))*(a3/2-a2-Ebeta1)))) //


//a1=phi, a2=VOLT
macro jpbO2du1(a1,a2) (2*F*k0BETApb02*(1/u1theta)*exp((((2-alphaCBETApbo2)*F)/(R*T))*(a2/2-a1-Ebeta1))) //


//a1=u2, a2=phi, a3=VOLT, Spbo2=CbpbO2, Spbo=CpbO    ----    jpbO2du2(u2,phi,VOLT,CbpbO2,CpbO)
macro jpbO2du2(a1,a2,a3,Spbo2,Spbo) (-2*F*k0BETApb02*(Spbo2/(Spbo2+Spbo+1e-90))*((4*a1^3)/(u2theta^4))*exp(-((alphaCBETApbo2*F)/(R*T))*(a3/2-a2-Ebeta1))) //


//a1=u1, a2=phi, a3=VOLT, Spbo2=CbpbO2, Spbo=CpbO, a5=u2    ----    jpbO2dphi(u1,phi,VOLT,CbpbO2,CpbO,u2)
macro jpbO2dphi(a1,a2,a3,Spbo2,Spbo,a5) (-2*F*k0BETApb02*((a1/u1theta)*(((2-alphaCBETApbo2)*F)/(R*T))*exp((((2-alphaCBETApbo2)*F)/(R*T))*(a3/2-a2-Ebeta1)) + (Spbo2/(Spbo2+Spbo+1e-90))*((a5/u2theta)^4)*((alphaCBETApbo2*F)/(R*T))*exp(-((alphaCBETApbo2*F)/(R*T))*(a3/2-a2-Ebeta1)))) //




//a1=u2, a2=phi, a3=VOLT, Spbo2=CbpbO2, Spbo=CpbO    ---   jpbO(u2,phi,VOLT,CbpbO2,CpbO) 
macro jpbO(a1,a2,a3,Spbo2,Spbo) (2*F*k0pboBETA*((Spbo/(Spbo2+Spbo+1e-90))*exp((((2-alphaCpboBETA)*F)/(R*T))*(a3/2-a2-Ebeta2))-(Spbo2/(Spbo2+Spbo+1e-90))*((a1/u2theta)^2)*exp(-((alphaCpboBETA*F)/(R*T))*(a3/2-a2-Ebeta2)))) //


//a1=u2,a2=phi,a3=VOLT,Spbo2=CbpbO2,Spbo=CpbO    ----    jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO)
macro jpbOdu2(a1,a2,a3,Spbo2,Spbo) (-2*F*k0pboBETA*(Spbo2/(Spbo2+Spbo+1e-90))*((2*a1)/(u2theta^2))*exp(-((alphaCpboBETA*F)/(R*T))*(a3/2-a2-Ebeta2))) //


//a1=u2, a2=phi, a3=VOLT, Spbo2=CbpbO2, Spbo=CpbO    ----    jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO)
macro jpbOdphi(a1,a2,a3,Spbo2,Spbo) (-2*F*k0pboBETA*((Spbo/(Spbo2+Spbo+1e-90))*(((2-alphaCpboBETA)*F)/(R*T))*exp((((2-alphaCpboBETA)*F)/(R*T))*(a3/2-a2-Ebeta2)) + (Spbo2/(Spbo2+Spbo+1e-90))*((a1/u2theta)^2)*((alphaCpboBETA*F)/(R*T))*exp(-((alphaCpboBETA*F)/(R*T))*(a3/2-a2-Ebeta2)))) //




//a1=Cpb, a2=phi
macro DjpbDcpb(a1,a2) (2*F*k0pb*(0.5*k*(cosh(k*(a1-DELTA)))^-2)*exp((((2-alphaCpb)*F)/(R*T))*(-VOLT/2-a2-Eminus))) // // Alt: DjpbDcpb=0 (because, apb=1 for all Cpb)


//a1=CbpbO2, a2=CpbO, a3=u2, a4=VOLT, a5=phi
macro Djpbo2Dcpbo2(a1,a2,a3,a4,a5) (-2*F*k0BETApb02*(a2/((a2+a1)^2 + 1e-90))*((a3/u2theta)^4)*exp(-((alphaCBETApbo2*F)/(R*T))*(a4/2-a5-Ebeta1)) ) //

//a1=CbpbO2, a2=CpbO, a3=u2, a4=VOLT, a5=phi
macro Djpbo2Dcpbo(a1,a2,a3,a4,a5) ( 2*F*k0BETApb02*(a1/((a2+a1)^2 + 1e-90))*((a3/u2theta)^4)*exp(-((alphaCBETApbo2*F)/(R*T))*(a4/2-a5-Ebeta1)) ) //


//a1=u2, a2=phi, a3=VOLT, a4=CpbO, a5=CbpbO2
macro DjpboDcpbo2(a1,a2,a3,a4,a5) (2*F*k0pboBETA*(((-a4/((a4+a5)^2+1e-90)))*exp((((2-alphaCpboBETA)*F)/(R*T))*(a3/2-a2-Ebeta2))-(a4/((a4+a5)^2 + 1e-90))*((a1/u2theta)^2)*exp(-((alphaCpboBETA*F)/(R*T))*(a3/2-a2-Ebeta2)))) //


//a1=u2, a2=phi, a3=VOLT, a4=CpbO, a5=CbpbO2
macro DjpboDcpbo(a1,a2,a3,a4,a5) (2*F*k0pboBETA*(((a5/((a4+a5)^2+1e-90)))*exp((((2-alphaCpboBETA)*F)/(R*T))*(a3/2-a2-Ebeta2))+(a5/((a4+a5)^2 + 1e-90))*((a1/u2theta)^2)*exp(-((alphaCpboBETA*F)/(R*T))*(a3/2-a2-Ebeta2)))) //





//a1=u1, a2=phi, a3=VOLT, Spbo2=CbpbO2, Spbo=CpbO, a6=u2    ----     Djpbo2Dvolt(u1,phi,VOLT,CbpbO2,CpbO,u2)
macro Djpbo2Dvolt(a1,a2,a3,Spbo2,Spbo,a6) (2*F*k0BETApb02*((a1/u1theta)*0.5*(((2-alphaCBETApbo2)*F)/(R*T))*exp((((2-alphaCBETApbo2)*F)/(R*T))*(a3/2-a2-Ebeta1))-(Spbo2/(Spbo2+Spbo+1e-90))*((a6/u2theta)^4)*0.5*(-(alphaCBETApbo2*F)/(R*T))*exp(-((alphaCBETApbo2*F)/(R*T))*(a3/2-a2-Ebeta1)))) //


//a1=u2, a2=phi, a3=VOLT, Spbo2=CbpbO2, Spbo=CpbO     ----       DjpboDvolt(u2,phi,VOLT,CbpbO2,CpbO)
macro DjpboDvolt(a1,a2,a3,Spbo2,Spbo) (2*F*k0pboBETA*((Spbo/(Spbo2+Spbo+1e-90))*0.5*(((2-alphaCpboBETA)*F)/(R*T))*exp((((2-alphaCpboBETA)*F)/(R*T))*(a3/2-a2-Ebeta2))-(Spbo2/(Spbo2+Spbo+1e-90))*((a1/u2theta)^2)*0.5*(-(alphaCpboBETA*F)/(R*T))*exp(-((alphaCpboBETA*F)/(R*T))*(a3/2-a2-Ebeta2)))) //
//*/








//Weak formulations

problem dHeat (du1, du2, dphi, v1, v2, v3)//, solver="MUMPS") //the order matters: put your unknowns first, then your test functions

    =int2d(dom4)(

        du1*v1 //bilinear

        + du2*v2

        -dt*((-u1*((du1*L11du1FE + du2*L11du2FE)*R*T*dx(u1) + L11FE*R*T*dx(du1) + (du1*L11du1FE + du2*L11du2FE)*z1*F*u1*dx(phi) + L11FE*z1*F*(u1*dx(dphi) + du1*dx(phi)) + (du1*L12du1FE + du2*L12du2FE)*R*T*dx(u2) + L12FE*R*T*dx(du2) + (du1*L12du1FE + du2*L12du2FE)*z2*F*u2*dx(phi) + L12FE*z2*F*(u2*dx(dphi) + du2*dx(phi)) + (du1*L13du1FE + du2*L13du2FE)*R*T*(2*dx(u1) + dx(u2)) + L13FE*R*T*(2*dx(du1)+dx(du2)) + (du1*L13du1FE + du2*L13du2FE)*z3*F*((2*u1+u2)*dx(phi)) + L13FE*z3*F*((2*u1+u2)*dx(dphi) + (2*du1+du2)*dx(phi)) )  -  du1*(L11FE*R*T*dx(u1) + L11FE*z1*F*u1*dx(phi) + L12FE*R*T*dx(u2) + L12FE*z2*F*u2*dx(phi) + L13FE*R*T*(2*dx(u1) + dx(u2)) + L13FE*z3*F*((2*u1+u2)*dx(phi))))*dx(v1) + ((6*V/(W^2))*du1*x*(W-x) - u1*((du1*L11du1FE + du2*L11du2FE)*R*T*dy(u1) + L11FE*R*T*dy(du1) + (du1*L11du1FE + du2*L11du2FE)*z1*F*u1*dy(phi) + L11FE*z1*F*(u1*dy(dphi) + du1*dy(phi)) + (du1*L12du1FE + du2*L12du2FE)*R*T*dy(u2) + L12FE*R*T*dy(du2) + (du1*L12du1FE + du2*L12du2FE)*z2*F*u2*dy(phi) + L12FE*z2*F*(u2*dy(dphi) + du2*dy(phi)) + (du1*L13du1FE + du2*L13du2FE)*R*T*(2*dy(u1) + dy(u2)) + L13FE*R*T*(2*dy(du1)+dy(du2)) + (du1*L13du1FE + du2*L13du2FE)*z3*F*((2*u1+u2)*dy(phi)) + L13FE*z3*F*((2*u1+u2)*dy(dphi) + (2*du1+du2)*dy(phi)) )  -  du1*(L11FE*R*T*dy(u1) + L11FE*z1*F*u1*dy(phi) + L12FE*R*T*dy(u2) + L12FE*z2*F*u2*dy(phi) + L13FE*R*T*(2*dy(u1) + dy(u2)) + L13FE*z3*F*((2*u1+u2)*dy(phi))))*dy(v1)) // -dt*(N1x*dx(v1) + N1y*dy(v1))

