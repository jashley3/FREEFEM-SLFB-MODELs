        L13FE=L13(uni1,uin2); L13du1FE=L13du1(uin1,uin2); L13du2FE=L13du2(uin1,uin2);
        L23FE=L23(uin1,uin2); L23du1FE=L23du1(uin1,uin2); L23du2FE=L23du2(uin1,uin2);
        L22FE=L22(uin1,uin2); L22du1FE=L22du1(uin1,uin2); L22du2FE=L22du2(uin1,uin2);
        L33FE=L33(uin1,uin2); L33du1FE=L33du1(uin1,uin2); L33du2FE=L33du2(uin1,uin2);

        kappaFE=kappa(uin1,uin2);

        
