M11FE=M11(uin1,uin2); M11du1FE=M11du1(uin1,uin2); M11du2FE=M11du2(uin1,uin2);
M12FE=M12(uin1,uin2); M12du1FE=M12du1(uin1,uin2); M12du2FE=M12du2(uin1,uin2);
