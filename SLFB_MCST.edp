        -dt*((-u1*((du1*L11du1FE + du2*L11du2FE)*R*T*dx(u1) + L11FE*R*T*dx(du1) + (du1*L11du1FE + du2*L11du2FE)*z1*F*u1*dx(phi) + L11FE*z1*F*(u1*dx(dphi) + du1*dx(phi)) + (du1*L12du1FE + du2*L12du2FE)*R*T*dx(u2) + L12FE*R*T*dx(du2) + (du1*L12du1FE + du2*L12du2FE)*z2*F*u2*dx(phi) + L12FE*z2*F*(u2*dx(dphi) + du2*dx(phi)) + (du1*L13du1FE + du2*L13du2FE)*R*T*(2*dx(u1) + dx(u2)) + L13FE*R*T*(2*dx(du1)+dx(du2)) + (du1*L13du1FE + du2*L13du2FE)*z3*F*((2*u1+u2)*dx(phi)) + L13FE*z3*F*((2*u1+u2)*dx(dphi) + (2*du1+du2)*dx(phi)) )  -  du1*(L11FE*R*T*dx(u1) + L11FE*z1*F*u1*dx(phi) + L12FE*R*T*dx(u2) + L12FE*z2*F*u2*dx(phi) + L13FE*R*T*(2*dx(u1) + dx(u2)) + L13FE*z3*F*((2*u1+u2)*dx(phi))))*dx(v1) + ((6*V/(W^2))*du1*x*(W-x) - u1*((du1*L11du1FE + du2*L11du2FE)*R*T*dy(u1) + L11FE*R*T*dy(du1) + (du1*L11du1FE + du2*L11du2FE)*z1*F*u1*dy(phi) + L11FE*z1*F*(u1*dy(dphi) + du1*dy(phi)) + (du1*L12du1FE + du2*L12du2FE)*R*T*dy(u2) + L12FE*R*T*dy(du2) + (du1*L12du1FE + du2*L12du2FE)*z2*F*u2*dy(phi) + L12FE*z2*F*(u2*dy(dphi) + du2*dy(phi)) + (du1*L13du1FE + du2*L13du2FE)*R*T*(2*dy(u1) + dy(u2)) + L13FE*R*T*(2*dy(du1)+dy(du2)) + (du1*L13du1FE + du2*L13du2FE)*z3*F*((2*u1+u2)*dy(phi)) + L13FE*z3*F*((2*u1+u2)*dy(dphi) + (2*du1+du2)*dy(phi)) )  -  du1*(L11FE*R*T*dy(u1) + L11FE*z1*F*u1*dy(phi) + L12FE*R*T*dy(u2) + L12FE*z2*F*u2*dy(phi) + L13FE*R*T*(2*dy(u1) + dy(u2)) + L13FE*z3*F*((2*u1+u2)*dy(phi))))*dy(v1)) // -dt*(N1x*dx(v1) + N1y*dy(v1))

