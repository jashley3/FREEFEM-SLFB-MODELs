        }
        real CpbOAv=(sumCpbO)/(Vh4ver2bound.ndof);
        cout<<"Average cumulative PbO concentration="<<CpbOAv<<endl;

        cout<<"----"<<endl;

        

        Krestart=0;


        itotvals.resize(m+2);
        itotvals[m+1] = itot;

      

        //To prevent overshoot of the specified end time
        if(t+dtmax>ttotal){
            while(t+dtmax>ttotal){
                dtmax=dtmax*(1.5)^(-1);
                if(dtmax<dtmin){
                    dtmax=dtmin;
                    break;
                }
            }
        }



        if(dt>dtmax){   //Make sure dt does not exceed dtmax after adjusting dtmax
            dt=dtmax;
        }
