        D12valsA.resize(m+2);
        D12valsA[m+1]=(1/(L*W))*int2d(dom4)(R*T*u1*u2/(55308*D12(u1,u2))); 

        D13valsA.resize(m+2);
        D13valsA[m+1]=(1/(L*W))*int2d(dom4)(R*T*u1*(2*u1+u2)/(55308*D13(u1,u2))); 

        D23valsA.resize(m+2);
        D23valsA[m+1]=(1/(L*W))*int2d(dom4)(R*T*u2*(2*u1+u2)/(55308*D23(u1,u2))); 

        t1vals.resize(m+2);
        t1vals[m+1]=(1/(L*W))*int2d(dom4)( ((z1*u1*F^2)/kappa(u1,u2))*( z1*u1*L11(u1,u2) + z2*u2*L12(u1,u2) + z3*(2*u1+u2)*L13(u1,u2) ) ); 

        t2vals.resize(m+2);
        t2vals[m+1]=(1/(L*W))*int2d(dom4)( ((z2*u2*F^2)/kappa(u1,u2))*( z1*u1*L12(u1,u2) + z2*u2*L22(u1,u2) + z3*(2*u1+u2)*L23(u1,u2) ) ); 

        t3vals.resize(m+2);
        t3vals[m+1]=(1/(L*W))*int2d(dom4)( ((z3*(2*u1+u2)*F^2)/kappa(u1,u2))*( z1*u1*L13(u1,u2) + z2*u2*L23(u1,u2) + z3*(2*u1+u2)*L33(u1,u2) ) ); 



        

