            }
        }
        if(KcancelSim==1) break;
        if(K2==1) break;

        


        cout<<"---"<<endl;
        cout<<"Ipos="<<I<<endl;

        cout<<"Ineg="<<Ineg<<endl;

        cout<<"Iapp="<<Iapp(t)<<endl;
        cout<<"---"<<endl;


       
    
        int Icounter=0;
        while(abs(D*int1d(dom4, 4)(jpbO2(u1,phi,VOLT,CbpbO2,CpbO,u2)+jpbO(u2,phi,VOLT,CbpbO2,CpbO))-Iapp(t))>1e-9){

            VOLTprev2=VOLTprev;
            VOLTprev=VOLT;
            dVOLT=(Iapp(t) - D*int1d(dom4, 4)(jpbO2(u1,phi,VOLT,CbpbO2,CpbO,u2)+jpbO(u2,phi,VOLT,CbpbO2,CpbO)))/(D*int1d(dom4, 4)(Djpbo2Dvolt(u1,phi,VOLT,CbpbO2,CpbO,u2) + DjpboDvolt(u2,phi,VOLT,CbpbO2,CpbO)));
            VOLT = VOLT + dVOLT;
            
            if(Icounter>1 && m>0){
                if(abs(abs(VOLT)-abs(VOLTprev))>=abs(abs(VOLTprev)-abs(VOLTprev2))){

                    if(dt==dtmin){
                        KcancelSim=1;
                        break;
                    }

                    m-=1;  
                    dt=dt/stepsizeratio;
                    if(dt<dtmin){
                        dt=dtmin;
                    }
                    t=timevals[timevals.n-1];

