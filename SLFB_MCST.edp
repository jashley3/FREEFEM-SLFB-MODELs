//Integers used when a step fails
int K2=0;
int Krestart=0;
int KcancelSim=0;









VOLT=VOLTguess; //Initial guess of voltage

real Ineg = D*int1d(dom4, 2)(jpb(u1,phi,Cpb)); //Current at the negative electrode
real InegPrev;

real I = D*int1d(dom4, 4)(jpbO2(u1,phi,VOLT,CbpbO2,CpbO,u2)+jpbO(u2,phi,VOLT,CbpbO2,CpbO)); //Current at the positive electrode
real Iprev;




int mrestart;

int itot;



dt=dtmin; dtold=dtmin; dtold2=dtmin; dtold3=dtmin;
DT=dt;



t=t-dt;






real[int] mvals; 
int m=-1;  

mvals.resize(m+2);
