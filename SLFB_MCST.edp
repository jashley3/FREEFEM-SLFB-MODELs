ofstream Cpbo2file("CbpbO2AvVals.txt");
ofstream Cpbofile("CpbOAvVals.txt");
ofstream uin1file("uin1AvVals.txt");
ofstream uin2file("uin2AvVals.txt");
ofstream kappafileA("kappaA.txt");
ofstream D10fileA("D10A.txt");
ofstream D20fileA("D20A.txt");
ofstream D30fileA("D30A.txt");
ofstream D12fileA("D12A.txt");
ofstream D13fileA("D13A.txt");
ofstream D23fileA("D23A.txt");
ofstream t1fileA("t1.txt");
ofstream t2fileA("t2.txt");
ofstream t3fileA("t3.txt");


while (t<ttotal){ //Time loop

    cout<<" "<<endl;
    cout<<" "<<endl;
    cout<<" "<<endl;
    cout<<" "<<endl;
    cout<<" "<<endl;
    cout<<" "<<endl;
    cout<<" "<<endl;
    cout<<"------------"<<endl;
    cout<<"---timestep begins---"<<endl;
    cout<<"------------"<<endl;
    cout<<"Iapp="<<Iapp(t)<<endl;
    cout<<"dt="<<dt<<endl;
    cout<<"restarts="<<restartNum<<endl;


    m=m+1;
    mvals.resize(m+2);
    mvals[m+1]= m;

    

    if(m>0){
        dtold=timevals[timevals.n-1]-timevals[timevals.n-2];
    }
    if(m>1){
        dtold2=timevals[timevals.n-2]-timevals[timevals.n-3];
    }
    if(m>2){
        dtold3=timevals[timevals.n-3]-timevals[timevals.n-4];
    }




   


    if(dt>dtmin && t<tfinal[tfinal.n-1]){ //If time is past the final breakpoint, don't need to enter this. 
        for(int ii=iBP; ii<tfinal.n; ii++){
            if(t<tfinal[ii]){
                ibreak=ii;
                iBP=ii-1;
                break;
            }
        }

        if(t + 2*dt>tfinal[ibreak]){
            while(t+2*dt>tfinal[ibreak]){
                if((abs(Iapp(t+dt)-Iapp(t))/abs(Iapp(t)+1e-10))<=0.01 && (t + dt<=tfinal[ibreak])){ //If the applied current changes by 1% or less relative to its current value, go with that value.
                    break;                                              //Will prevent dt from shrinking all the way to dtmin unnecessarily.
                }
                dt=0.5*dt;
                if(dt<dtmin){
                    dt=dtmin;
                    break;
                }
            }
        }
    }

    t=t+dt;


    cout<<"Cell voltage="<<VOLT<<endl;
    cout<<"m="<<m<<endl;
    cout<<"t="<<t<<endl;
