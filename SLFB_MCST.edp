            dCbpbO2Lin = (1 - SIG1)^(-1)*(-(Rpbo2/om) - CbpbO2 + ((om^-1)/(2*F))*(jpbO2(u1,phi,VOLT,CbpbO2,CpbO,u2) + jpbO(u2,phi,VOLT,CbpbO2,CpbO) + (Djpbo2Dcpbo(CbpbO2,CpbO,u2,VOLT,phi) + DjpboDcpbo(u2,phi,VOLT,CpbO,CbpbO2))*GAM1*H1));
            dCpbOLin = GAM1*H1 - GAM1*((om^-1)/(2*F))*DjpboDcpbo2(u2,phi,VOLT,CpbO,CbpbO2)*dCbpbO2Lin;
            dCpbLin = (1 + ((om^-1)/(2*F))*DjpbDcpb(Cpb,phi))^(-1)*(-(Rpb/om)  - Cpb - ((om^-1)/(2*F))*jpb(u1,phi,Cpb));

            try{
                D10FE=D10(u1,u2); D10du1FE=D10du1(u1,u2); D10du2FE=D10du2(u1,u2);
                D12FE=D12(u1,u2); D12du1FE=D12du1(u1,u2); D12du2FE=D12du2(u1,u2);
                D13FE=D13(u1,u2); D13du1FE=D13du1(u1,u2); D13du2FE=D13du2(u1,u2);
                D23FE=D23(u1,u2); D23du1FE=D23du1(u1,u2); D23du2FE=D23du2(u1,u2);
                D20FE=D20(u1,u2); D20du1FE=D20du1(u1,u2); D20du2FE=D20du2(u1,u2);
                D30FE=D30(u1,u2); D30du1FE=D30du1(u1,u2); D30du2FE=D30du2(u1,u2);

                M11FE=M11(u1,u2); M11du1FE=M11du1(u1,u2); M11du2FE=M11du2(u1,u2);
                M12FE=M12(u1,u2); M12du1FE=M12du1(u1,u2); M12du2FE=M12du2(u1,u2);
                M13FE=M13(u1,u2); M13du1FE=M13du1(u1,u2); M13du2FE=M13du2(u1,u2);
                M23FE=M23(u1,u2); M23du1FE=M23du1(u1,u2); M23du2FE=M23du2(u1,u2);
                M22FE=M22(u1,u2); M22du1FE=M22du1(u1,u2); M22du2FE=M22du2(u1,u2);
                M33FE=M33(u1,u2); M33du1FE=M33du1(u1,u2); M33du2FE=M33du2(u1,u2);

                Denom2FE=Denom2(u1,u2); Denom2du1FE=Denom2du1(u1,u2); Denom2du2FE=Denom2du2(u1,u2);

                L11FE=L11(u1,u2); L11du1FE=L11du1(u1,u2); L11du2FE=L11du2(u1,u2);
                L12FE=L12(u1,u2); L12du1FE=L12du1(u1,u2); L12du2FE=L12du2(u1,u2);
                L13FE=L13(u1,u2); L13du1FE=L13du1(u1,u2); L13du2FE=L13du2(u1,u2);
                L23FE=L23(u1,u2); L23du1FE=L23du1(u1,u2); L23du2FE=L23du2(u1,u2);
                L22FE=L22(u1,u2); L22du1FE=L22du1(u1,u2); L22du2FE=L22du2(u1,u2);
                L33FE=L33(u1,u2); L33du1FE=L33du1(u1,u2); L33du2FE=L33du2(u1,u2);
                dHeat2;//dHeat2;
            }

            catch(...){   //this will catch an NAN error should it occur

                if(dt==dtmin){
                    KcancelSim=1;
                    break;
                }

                m-=1;  
                dt=dt/stepsizeratio;
                if(dt<dtmin){
                    dt=dtmin;
                }
                t=timevals[timevals.n-1];

                K2=1;
                Krestart=1;
                mrestart=m;

                mcount=MC;

                restartNum=restartNum+1;

                u1=U1[U1.n-1]; u2=U2[U2.n-1]; phi=PHI[PHI.n-1]; VOLT=voltvals[voltvals.n-1]; Cpb=CPB[Nstore-1]; CbpbO2=CPBO2[Nstore-1]; CpbO=CPBO[Nstore-1];
                


            }

            cout<<"BDF2"<<endl;

        }



        if(KcancelSim==1) break;
        if(K2==1) break;

        



        //Update solutions

        dCpbO = dCpbOLin + (-GAM1*(dt/(2*F))*(du2*jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO) + dphi*jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO)) - GAM1*(dt/(2*F))*DjpboDcpbo2(u2,phi,VOLT,CpbO,CbpbO2)*(1 - SIG1)^(-1)*(dt/(2*F))*(du1*jpbO2du1(phi,VOLT) + du2*(jpbO2du2(u2,phi,VOLT,CbpbO2,CpbO) + jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO)) + dphi*(jpbO2dphi(u1,phi,VOLT,CbpbO2,CpbO,u2) + jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO)) - (Djpbo2Dcpbo(CbpbO2,CpbO,u2,VOLT,phi) + DjpboDcpbo(u2,phi,VOLT,CpbO,CbpbO2))*GAM1*(dt/(2*F))*(du2*jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO) + dphi*jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO))));

        dCbpbO2 = dCbpbO2Lin + ((1 - SIG1)^(-1)*(dt/(2*F))*(du1*jpbO2du1(phi,VOLT) + du2*(jpbO2du2(u2,phi,VOLT,CbpbO2,CpbO) + jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO)) + dphi*(jpbO2dphi(u1,phi,VOLT,CbpbO2,CpbO,u2) + jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO)) - (Djpbo2Dcpbo(CbpbO2,CpbO,u2,VOLT,phi) + DjpboDcpbo(u2,phi,VOLT,CpbO,CbpbO2))*GAM1*(dt/(2*F))*(du2*jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO) + dphi*jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO))));

        dCpb = dCpbLin + (-(1 + (dt/(2*F))*DjpbDcpb(Cpb,phi))^(-1)*(dt/(2*F))*(du1*jpbdu1(phi) + dphi*jpbdphi(u1,phi,Cpb)));

        CpbO[]+=dCpbO[];
        CpbO=(0.5+0.5*tanh(k*(CpbO-DELTA)))*CpbO;

        CbpbO2[]+=dCbpbO2[];
        CbpbO2=(0.5+0.5*tanh(k*(CbpbO2-DELTA)))*CbpbO2;

        Cpb[]+=dCpb[];
        Cpb=(0.5+0.5*tanh(k*(Cpb-DELTA)))*Cpb;


        u1[]+=du1[];    

        u2[]+=du2[];

        phi[]+=dphi[];



        check=0;
        dHeat3check=0;





        //Solve for inlet concentrations

        //BDF1
        if(m==0){

            check=1;

            uin1 = (1 + ((dt*D)/Vr)*V*W)^(-1)*(UIN1[Nstore-1] + (dt*D/Vr)*int1d(dom4,3)(((6*V/(W^2))*x*(W-x))*u1));

            uin2 = (1 + ((dt*D)/Vr)*V*W)^(-1)*(UIN2[Nstore-1] + (dt*D/Vr)*int1d(dom4,3)(((6*V/(W^2))*x*(W-x))*u2));
        }


        //BDF3
        if(m>=2 && dt/dtold<=2.01 && dt/dtold>=0.49 && dtold/dtold2<=2.01 && dtold/dtold2>=0.49 && check==0 && BDF3==1){

            dHeat3check=1;

            om = ((1+2*(dt/dtold))/(1+(dt/dtold))) + (((dt/dtold)*(dtold/dtold2))/(1 + (dtold/dtold2) + (dt/dtold)*(dtold/dtold2)));
            
            Rc1in = -(((dt/dtold)/(1+(dt/dtold))) + (((dt/dtold)*(dtold/dtold2))/(1 + (dtold/dtold2) + (dt/dtold)*(dtold/dtold2))) + (((dt/dtold)*((dtold/dtold2)^2)*(1+(dt/dtold)))/((1 + (dtold/dtold2) + (dt/dtold)*(dtold/dtold2))*(1+(dtold/dtold2)))))*((UIN1[Nstore-1] - UIN1[Nstore-2])/dtold) + ((((dt/dtold)*((dtold/dtold2)^2)*(1+(dt/dtold)))/((1 + (dtold/dtold2) + (dt/dtold)*(dtold/dtold2))*(1+(dtold/dtold2)))))*((UIN1[Nstore-2] - UIN1[Nstore-3])/dtold2) ;
            uin1 = (1 + ((dt*D*V*W)/(om*Vr)))^(-1)*(UIN1[Nstore-1] -(dt*Rc1in/om) + (dt*D/(om*Vr))*int1d(dom4,3)(((6*V/(W^2))*x*(W-x))*u1));

            Rc2in = -(((dt/dtold)/(1+(dt/dtold))) + (((dt/dtold)*(dtold/dtold2))/(1 + (dtold/dtold2) + (dt/dtold)*(dtold/dtold2))) + (((dt/dtold)*((dtold/dtold2)^2)*(1+(dt/dtold)))/((1 + (dtold/dtold2) + (dt/dtold)*(dtold/dtold2))*(1+(dtold/dtold2)))))*((UIN2[Nstore-1] - UIN2[Nstore-2])/dtold) + ((((dt/dtold)*((dtold/dtold2)^2)*(1+(dt/dtold)))/((1 + (dtold/dtold2) + (dt/dtold)*(dtold/dtold2))*(1+(dtold/dtold2)))))*((UIN2[Nstore-2] - UIN2[Nstore-3])/dtold2) ;
            uin2 = (1 + ((dt*D*V*W)/(om*Vr)))^(-1)*(UIN2[Nstore-1] -(dt*Rc2in/om) + (dt*D/(om*Vr))*int1d(dom4,3)(((6*V/(W^2))*x*(W-x))*u2));

    
        }


        //BDF2
        if(m>=1 && dHeat3check==0 && check==0){
            om = ((1+2*(dt/dtold))/(1+(dt/dtold)));

            Rc1in = (-((dt/dtold)/(1+(dt/dtold)))*((UIN1[Nstore-1] - UIN1[Nstore-2])/dtold)); 
            uin1 = (1 + ((dt*D*V*W)/(om*Vr)))^(-1)*(UIN1[Nstore-1] -(dt*Rc1in/om) + (dt*D/(om*Vr))*int1d(dom4,3)(((6*V/(W^2))*x*(W-x))*u1));

            Rc2in = (-((dt/dtold)/(1+(dt/dtold)))*((UIN2[Nstore-1] - UIN2[Nstore-2])/dtold)); 
            uin2 = (1 + ((dt*D*V*W)/(om*Vr)))^(-1)*(UIN2[Nstore-1] -(dt*Rc2in/om) + (dt*D/(om*Vr))*int1d(dom4,3)(((6*V/(W^2))*x*(W-x))*u2));
        }



        check=0;
        dHeat3check=0;


