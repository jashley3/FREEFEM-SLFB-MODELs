        if(u1wall2[].max<=0 && Iapp(t)>0){

            cout<<"Pb2+ conc. depleted along negative electrode"<<endl;

            break;

        }



        if(u1wall1[].max<=0 && Iapp(t)>0){

            cout<<"Pb2+ conc. depleted along positive electrode"<<endl;

            break;

        }



        if(u2wall1[].max<=0 && Iapp(t)<0){

            cout<<"H+ conc. depleted along positive electrode"<<endl;

            break;

        }



        if(u2wall2[].max<=0 && Iapp(t)<0){

            cout<<"H+ conc. depleted along negative electrode"<<endl;

