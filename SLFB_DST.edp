load "Element_P3"
load "Element_P4"
load "msh3"
load "MUMPS_seq"
load "iovtk"

cout.precision(10); 



ifstream in("BreakpointsForFreeFemCode.txt"); //Generated using BreakPointsPython6
int Nbreak;
in >> Nbreak;                       // read first line: number of points
real[int] tfinal(Nbreak);           // preallocate
for (int i = 0; i < Nbreak; ++i)
    in >> tfinal[i];           // read values

cout << "Imported " << tfinal.n << " points:\n";
cout << tfinal << endl;

int ibreak=0;



real dt; //Current timestep
real DT;
real dtold; //Previous timestep value A
real dtold2; //Previous timestep value B
real dtold3;
real om;


//Integers used to indicate which BDF order is being used
int check=0;
int dHeat3check=0;




//File containing the model parameters, error tolerances and mesh.
include "ParametersAndMesh.edp";

//Self-diffusion coefficients
real mu1 = 9.2473e-10*(1+0.0233496*(T-298)+0.000146144*(T-298)^2); // Diffusion coefficient for Pb2+
real mu2 = 9.3297e-9*(1+0.0165032*(T-298)); // Diffusion coefficient for H+
real mu3 = 1.4441e-9*(1+0.0229309*(T-298)+0.000173225*(T-298)^2);//2e-10; // Diffusion coefficient fo CH3SO3-

real k=1e21; //Parameter 1 for the continuous Heaviside functions
real DELTA=1e-18; //Parameter 2 for the continuous Heaviside functions




real VOLT; //Voltage across the cell (this is the voltage in the solid phase of the positive electrode, but we set the analgous value in the negative electrode to zero. So, VOLT=VOLTplus - VOLTminus=Voltplus.). This quantity is spatially invariant in our model, so it is only a real number, not a FE function.
real dVOLT;
real VOLTprev;
real VOLTprev2;
real err1=1; //The error associated with the Newton iterations (not used in solver, but useful quantity to track). Need to initialise it so the while loop doesn't immediately cancel.




int[int] ll=[1];
meshL TBh = extract(dom4,label=ll);
fespace VBh(TBh,P1);


int[int] llout=[3];
meshL TBhout = extract(dom4,label=llout);
fespace VBhout(TBhout,P1);

//Negative electrode
int[int] ll3=[2]; 
meshL dom4wall2 = extract(dom4,label=ll3); // extract only border with label wall2  Alternatively, define on dom4fixed
fespace Vh4bound(dom4wall2,P1);


//Positive electrode
int[int] ll4=[4]; 
meshL dom4wall1 = extract(dom4,label=ll4); // extract only border with label wall2  Aleternatively, define on dom4fixed
fespace Vh4ver2bound(dom4wall1,P1);




fespace Vh(dom4, P1); 

Vh du1, v1, u1;

real uin1;




fespace Vh2(dom4, P1);

Vh2 du2, v2, u2;

real uin2;




fespace Vh3(dom4, P1);

Vh3 dphi, v3, phi;  





Vh4ver2bound  CbpbO2, dCbpbO2, CpbO, dCpbO, dCbpbO2Lin, dCpbOLin, GAM1, H1, SIG1,  Rpbo2, Rpbo;

Vh4bound Cpb, dCpb, dCpbLin, Rpb;

real Rc1in, Rc2in;


fespace Vh5(dom4, P2);

Vh5 jpbFE, jpbdu1FE, jpbdphiFE, jpbO2FE, jpbO2du1FE, jpbO2du2FE, jpbO2dphiFE, jpbOFE, jpbOdu2FE, jpbOdphiFE;







int Nstore=5; //The number of most recent solutions the solver will store

Vh U1[Nstore];

Vh2 U2[Nstore];

Vh3 PHI[Nstore];

Vh4ver2bound CPBO2[Nstore], CPBO[Nstore];

Vh4bound CPB[Nstore];

real[int] UIN1(Nstore);
real[int] UIN2(Nstore);




//Define arrays for the quantities of interest
real[int] timevals; 
real[int] voltvals;
real[int] CpbAvVals;
real[int] CbpbO2AvVals;
real[int] CpbOAvVals;
real[int] itotvals; 
real[int] errvals; 
real[int] uin1AvVals;
real[int] uin2AvVals;
real[int] dvoltErrvals;
real[int] outintvals1;
real[int] outintvals2;
real[int] c1normvals;
real[int] c2normvals;
real[int] phinormvals;
real[int] kappavalsA;
real[int] D10valsA;
real[int] D20valsA;
real[int] D30valsA;
real[int] t1vals;
real[int] t2vals;
real[int] t3vals;






//Macros for the Butler-Volmer expressions and their derivatives:
//WHERE phiminus=-VOLT/2 and phiplus=VOLT/2

//a1=y   Place this in front of all macros for the Butler-VOlmers and their derivatives if smoothing is wanted near the inlet and outlet (transition to zero across a distance of 1mm)
macro smoother(a1) ((0.5+0.5*tanh(1e4*(a1-0.0005)))-(0.5+0.5*tanh(1e4*(a1-0.0995)))) //



//a1=u1, a2=phi, a3=Cpb jpb(u1,phi,Cpb)
macro jpb(a1,a2,a3) (2*F*k0pb*((0.5+0.5*tanh(k*(a3-DELTA)))*exp((((2-alphaCpb)*F)/(R*T))*(-(VOLT/2)-a2-Eminus))-(a1/u1theta)*exp(-((alphaCpb*F)/(R*T))*(-(VOLT/2)-a2-Eminus)))) //


//a1=phi
macro jpbdu1(a1) (-2*F*k0pb*(1/u1theta)*exp(-((alphaCpb*F)/(R*T))*(-(VOLT/2)-a1-Eminus))) //


//a1=u1, a2=phi, a3=Cpb jpb(u1,phi,Cpb)
macro jpbdphi(a1,a2,a3) (-2*F*k0pb*((0.5+0.5*tanh(k*(a3-DELTA)))*(((2-alphaCpb)*F)/(R*T))*exp((((2-alphaCpb)*F)/(R*T))*(-(VOLT/2)-a2-Eminus)) + (a1/u1theta)*((alphaCpb*F)/(R*T))*exp(-((alphaCpb*F)/(R*T))*(-(VOLT/2)-a2-Eminus)))) //




//a1=u1, a2=phi, a3=VOLT, Spbo2=CbpbO2, Spbo=CpbO, a6=u2   ---   jpbO2(u1,phi,VOLT,CbpbO2,CpbO,u2)
macro jpbO2(a1,a2,a3,Spbo2,Spbo,a6) (2*F*k0BETApb02*((a1/u1theta)*exp((((2-alphaCBETApbo2)*F)/(R*T))*(a3/2-a2-Ebeta1))-(Spbo2/(Spbo2+Spbo+1e-90))*((a6/u2theta)^4)*exp(-((alphaCBETApbo2*F)/(R*T))*(a3/2-a2-Ebeta1)))) //


//a1=phi, a2=VOLT
macro jpbO2du1(a1,a2) (2*F*k0BETApb02*(1/u1theta)*exp((((2-alphaCBETApbo2)*F)/(R*T))*(a2/2-a1-Ebeta1))) //


//a1=u2, a2=phi, a3=VOLT, Spbo2=CbpbO2, Spbo=CpbO    ----    jpbO2du2(u2,phi,VOLT,CbpbO2,CpbO)
macro jpbO2du2(a1,a2,a3,Spbo2,Spbo) (-2*F*k0BETApb02*(Spbo2/(Spbo2+Spbo+1e-90))*((4*a1^3)/(u2theta^4))*exp(-((alphaCBETApbo2*F)/(R*T))*(a3/2-a2-Ebeta1))) //


//a1=u1, a2=phi, a3=VOLT, Spbo2=CbpbO2, Spbo=CpbO, a5=u2    ----    jpbO2dphi(u1,phi,VOLT,CbpbO2,CpbO,u2)
macro jpbO2dphi(a1,a2,a3,Spbo2,Spbo,a5) (-2*F*k0BETApb02*((a1/u1theta)*(((2-alphaCBETApbo2)*F)/(R*T))*exp((((2-alphaCBETApbo2)*F)/(R*T))*(a3/2-a2-Ebeta1)) + (Spbo2/(Spbo2+Spbo+1e-90))*((a5/u2theta)^4)*((alphaCBETApbo2*F)/(R*T))*exp(-((alphaCBETApbo2*F)/(R*T))*(a3/2-a2-Ebeta1)))) //




//a1=u2, a2=phi, a3=VOLT, Spbo2=CbpbO2, Spbo=CpbO    ---   jpbO(u2,phi,VOLT,CbpbO2,CpbO) 
macro jpbO(a1,a2,a3,Spbo2,Spbo) (2*F*k0pboBETA*((Spbo/(Spbo2+Spbo+1e-90))*exp((((2-alphaCpboBETA)*F)/(R*T))*(a3/2-a2-Ebeta2))-(Spbo2/(Spbo2+Spbo+1e-90))*((a1/u2theta)^2)*exp(-((alphaCpboBETA*F)/(R*T))*(a3/2-a2-Ebeta2)))) //


//a1=u2,a2=phi,a3=VOLT,Spbo2=CbpbO2,Spbo=CpbO    ----    jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO)
macro jpbOdu2(a1,a2,a3,Spbo2,Spbo) (-2*F*k0pboBETA*(Spbo2/(Spbo2+Spbo+1e-90))*((2*a1)/(u2theta^2))*exp(-((alphaCpboBETA*F)/(R*T))*(a3/2-a2-Ebeta2))) //


//a1=u2, a2=phi, a3=VOLT, Spbo2=CbpbO2, Spbo=CpbO    ----    jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO)
macro jpbOdphi(a1,a2,a3,Spbo2,Spbo) (-2*F*k0pboBETA*((Spbo/(Spbo2+Spbo+1e-90))*(((2-alphaCpboBETA)*F)/(R*T))*exp((((2-alphaCpboBETA)*F)/(R*T))*(a3/2-a2-Ebeta2)) + (Spbo2/(Spbo2+Spbo+1e-90))*((a1/u2theta)^2)*((alphaCpboBETA*F)/(R*T))*exp(-((alphaCpboBETA*F)/(R*T))*(a3/2-a2-Ebeta2)))) //




//a1=Cpb, a2=phi
macro DjpbDcpb(a1,a2) (2*F*k0pb*(0.5*k*(cosh(k*(a1-DELTA)))^-2)*exp((((2-alphaCpb)*F)/(R*T))*(-VOLT/2-a2-Eminus))) // // Alt: DjpbDcpb=0 (because, apb=1 for all Cpb)


//a1=CbpbO2, a2=CpbO, a3=u2, a4=VOLT, a5=phi
macro Djpbo2Dcpbo2(a1,a2,a3,a4,a5) (-2*F*k0BETApb02*(a2/((a2+a1)^2 + 1e-90))*((a3/u2theta)^4)*exp(-((alphaCBETApbo2*F)/(R*T))*(a4/2-a5-Ebeta1)) ) //

//a1=CbpbO2, a2=CpbO, a3=u2, a4=VOLT, a5=phi
macro Djpbo2Dcpbo(a1,a2,a3,a4,a5) ( 2*F*k0BETApb02*(a1/((a2+a1)^2 + 1e-90))*((a3/u2theta)^4)*exp(-((alphaCBETApbo2*F)/(R*T))*(a4/2-a5-Ebeta1)) ) //


//a1=u2, a2=phi, a3=VOLT, a4=CpbO, a5=CbpbO2
macro DjpboDcpbo2(a1,a2,a3,a4,a5) (2*F*k0pboBETA*(((-a4/((a4+a5)^2+1e-90)))*exp((((2-alphaCpboBETA)*F)/(R*T))*(a3/2-a2-Ebeta2))-(a4/((a4+a5)^2 + 1e-90))*((a1/u2theta)^2)*exp(-((alphaCpboBETA*F)/(R*T))*(a3/2-a2-Ebeta2)))) //


//a1=u2, a2=phi, a3=VOLT, a4=CpbO, a5=CbpbO2
macro DjpboDcpbo(a1,a2,a3,a4,a5) (2*F*k0pboBETA*(((a5/((a4+a5)^2+1e-90)))*exp((((2-alphaCpboBETA)*F)/(R*T))*(a3/2-a2-Ebeta2))+(a5/((a4+a5)^2 + 1e-90))*((a1/u2theta)^2)*exp(-((alphaCpboBETA*F)/(R*T))*(a3/2-a2-Ebeta2)))) //





//a1=u1, a2=phi, a3=VOLT, Spbo2=CbpbO2, Spbo=CpbO, a6=u2    ----     Djpbo2Dvolt(u1,phi,VOLT,CbpbO2,CpbO,u2)
macro Djpbo2Dvolt(a1,a2,a3,Spbo2,Spbo,a6) (2*F*k0BETApb02*((a1/u1theta)*0.5*(((2-alphaCBETApbo2)*F)/(R*T))*exp((((2-alphaCBETApbo2)*F)/(R*T))*(a3/2-a2-Ebeta1))-(Spbo2/(Spbo2+Spbo+1e-90))*((a6/u2theta)^4)*0.5*(-(alphaCBETApbo2*F)/(R*T))*exp(-((alphaCBETApbo2*F)/(R*T))*(a3/2-a2-Ebeta1)))) //


//a1=u2, a2=phi, a3=VOLT, Spbo2=CbpbO2, Spbo=CpbO     ----       DjpboDvolt(u2,phi,VOLT,CbpbO2,CpbO)
macro DjpboDvolt(a1,a2,a3,Spbo2,Spbo) (2*F*k0pboBETA*((Spbo/(Spbo2+Spbo+1e-90))*0.5*(((2-alphaCpboBETA)*F)/(R*T))*exp((((2-alphaCpboBETA)*F)/(R*T))*(a3/2-a2-Ebeta2))-(Spbo2/(Spbo2+Spbo+1e-90))*((a1/u2theta)^2)*0.5*(-(alphaCpboBETA*F)/(R*T))*exp(-((alphaCpboBETA*F)/(R*T))*(a3/2-a2-Ebeta2)))) //
//*/








//Weak formulations

problem dHeat (du1, du2, dphi, v1, v2, v3)//, solver="MUMPS") //the order matters: put your unknowns first, then your test functions

    =int2d(dom4)(

        du1*v1 //bilinear

        + du2*v2

        + dt*mu1*(dx(du1)*dx(v1) + dy(du1)*dy(v1))

        + 2*dt*mu1*(F/(R*T))*(u1*(dx(dphi)*dx(v1) + dy(dphi)*dy(v1)) + du1*(dx(phi)*dx(v1) + dy(phi)*dy(v1)))

        - dt*(6*V/(W^2))*x*(W-x)*(du1*dy(v1))

        + dt*mu2*(dx(du2)*dx(v2) + dy(du2)*dy(v2))

        + dt*mu2*(F/(R*T))*(u2*(dx(dphi)*dx(v2) + dy(dphi)*dy(v2)) + du2*(dx(phi)*dx(v2) + dy(phi)*dy(v2)))

        - dt*(6*V/(W^2))*x*(W-x)*(du2*dy(v2))

        + dt*F*(2*mu1-2*mu3)*(dx(du1)*dx(v3) + dy(du1)*dy(v3))

        + dt*F*(mu2-mu3)*(dx(du2)*dx(v3) + dy(du2)*dy(v3))

        + dt*(F^2/(R*T))*((4*mu1+2*mu3)*(u1*(dx(dphi)*dx(v3) + dy(dphi)*dy(v3)) + du1*(dx(phi)*dx(v3) + dy(phi)*dy(v3))) + (mu2+mu3)*(u2*(dx(dphi)*dx(v3) + dy(dphi)*dy(v3)) + du2*(dx(phi)*dx(v3) + dy(phi)*dy(v3))))

    )

    + int2d(dom4)( //linear

        u1*v1

        + u2*v2

        + dt*mu1*(dx(u1)*dx(v1) + dy(u1)*dy(v1))

        + 2*dt*mu1*(F/(R*T))*u1*(dx(phi)*dx(v1) + dy(phi)*dy(v1))

        - dt*(6*V/(W^2))*x*(W-x)*(u1*dy(v1))

        + dt*mu2*(dx(u2)*dx(v2) + dy(u2)*dy(v2))

        + dt*mu2*(F/(R*T))*u2*(dx(phi)*dx(v2) + dy(phi)*dy(v2))

        - dt*(6*V/(W^2))*x*(W-x)*(u2*dy(v2))

        + dt*F*(2*mu1-2*mu3)*(dx(u1)*dx(v3) + dy(u1)*dy(v3))

        + dt*F*(mu2-mu3)*(dx(u2)*dx(v3) + dy(u2)*dy(v3))

        + dt*(F^2/(R*T))*((4*mu1+2*mu3)*u1*(dx(phi)*dx(v3) + dy(phi)*dy(v3)) + (mu2+mu3)*u2*(dx(phi)*dx(v3) + dy(phi)*dy(v3)))

    //)

    //+ int2d(dom4)(

        -U1[Nstore-1]*v1

        -U2[Nstore-1]*v2   

    )

    + int1d(dom4, 3)(dt*(6*V/(W^2))*x*(W-x)*(v1*u1) + dt*(6*V/(W^2))*x*(W-x)*(v2*u2)) //linear


    - int1d(dom4, 2)(dt*(1/(2*F))*v1*(jpb(u1,phi,Cpb) + dCpbLin*DjpbDcpb(Cpb,phi)) 

    + dt*v3*(jpb(u1,phi,Cpb) + dCpbLin*DjpbDcpb(Cpb,phi)))


    + int1d(dom4, 4)(dt*(1/(2*F))*v1*(jpbO2(u1,phi,VOLT,CbpbO2,CpbO,u2) + dCbpbO2Lin*Djpbo2Dcpbo2(CbpbO2,CpbO,u2,VOLT,phi) + dCpbOLin*Djpbo2Dcpbo(CbpbO2,CpbO,u2,VOLT,phi)) 

    - dt*(2/F)*v2*(jpbO2(u1,phi,VOLT,CbpbO2,CpbO,u2) + dCbpbO2Lin*Djpbo2Dcpbo2(CbpbO2,CpbO,u2,VOLT,phi) + dCpbOLin*Djpbo2Dcpbo(CbpbO2,CpbO,u2,VOLT,phi)) 

    - dt*(1/F)*v2*(jpbO(u2,phi,VOLT,CbpbO2,CpbO) + dCbpbO2Lin*DjpboDcpbo2(u2,phi,VOLT,CpbO,CbpbO2) + dCpbOLin*DjpboDcpbo(u2,phi,VOLT,CpbO,CbpbO2)) 

    - dt*v3*(jpbO2(u1,phi,VOLT,CbpbO2,CpbO,u2) + dCbpbO2Lin*Djpbo2Dcpbo2(CbpbO2,CpbO,u2,VOLT,phi) + dCpbOLin*Djpbo2Dcpbo(CbpbO2,CpbO,u2,VOLT,phi))
    
    - dt*v3*(jpbO(u2,phi,VOLT,CbpbO2,CpbO) + dCbpbO2Lin*DjpboDcpbo2(u2,phi,VOLT,CpbO,CbpbO2) + dCpbOLin*DjpboDcpbo(u2,phi,VOLT,CpbO,CbpbO2)))



    + int1d(dom4, 3)(dt*(6*V/(W^2))*x*(W-x)*(v1*du1) + dt*(6*V/(W^2))*x*(W-x)*(v2*du2)) //bilinear
    

    - int1d(dom4, 2)(dt*(1/(2*F))*v1*(du1*(jpbdu1(phi)) + dphi*(jpbdphi(u1,phi,Cpb)) + (-(1 + ((om^-1)/(2*F))*DjpbDcpb(Cpb,phi))^(-1)*((om^-1)/(2*F))*(du1*jpbdu1(phi) + dphi*jpbdphi(u1,phi,Cpb)))*DjpbDcpb(Cpb,phi)) 
    
    + dt*v3*(du1*(jpbdu1(phi)) + dphi*(jpbdphi(u1,phi,Cpb)) + (-(1 + ((om^-1)/(2*F))*DjpbDcpb(Cpb,phi))^(-1)*((om^-1)/(2*F))*(du1*jpbdu1(phi) + dphi*jpbdphi(u1,phi,Cpb)))*DjpbDcpb(Cpb,phi)))


    + int1d(dom4, 4)(dt*(1/(2*F))*v1*(du1*(jpbO2du1(phi,VOLT)) + du2*(jpbO2du2(u2,phi,VOLT,CbpbO2,CpbO)) + dphi*(jpbO2dphi(u1,phi,VOLT,CbpbO2,CpbO,u2)) + ((1 - SIG1)^(-1)*((om^-1)/(2*F))*(du1*jpbO2du1(phi,VOLT) + du2*(jpbO2du2(u2,phi,VOLT,CbpbO2,CpbO) + jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO)) + dphi*(jpbO2dphi(u1,phi,VOLT,CbpbO2,CpbO,u2) + jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO)) - (Djpbo2Dcpbo(CbpbO2,CpbO,u2,VOLT,phi) + DjpboDcpbo(u2,phi,VOLT,CpbO,CbpbO2))*GAM1*((om^-1)/(2*F))*(du2*jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO) + dphi*jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO))))*Djpbo2Dcpbo2(CbpbO2,CpbO,u2,VOLT,phi) + (-GAM1*((om^-1)/(2*F))*(du2*jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO) + dphi*jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO)) - GAM1*((om^-1)/(2*F))*DjpboDcpbo2(u2,phi,VOLT,CpbO,CbpbO2)*(1 - SIG1)^(-1)*((om^-1)/(2*F))*(du1*jpbO2du1(phi,VOLT) + du2*(jpbO2du2(u2,phi,VOLT,CbpbO2,CpbO) + jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO)) + dphi*(jpbO2dphi(u1,phi,VOLT,CbpbO2,CpbO,u2) + jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO)) - (Djpbo2Dcpbo(CbpbO2,CpbO,u2,VOLT,phi) + DjpboDcpbo(u2,phi,VOLT,CpbO,CbpbO2))*GAM1*((om^-1)/(2*F))*(du2*jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO) + dphi*jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO))))*Djpbo2Dcpbo(CbpbO2,CpbO,u2,VOLT,phi))

    -dt*(2/F)*v2*(du1*(jpbO2du1(phi,VOLT)) + du2*(jpbO2du2(u2,phi,VOLT,CbpbO2,CpbO)) + dphi*(jpbO2dphi(u1,phi,VOLT,CbpbO2,CpbO,u2)) + ((1 - SIG1)^(-1)*((om^-1)/(2*F))*(du1*jpbO2du1(phi,VOLT) + du2*(jpbO2du2(u2,phi,VOLT,CbpbO2,CpbO) + jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO)) + dphi*(jpbO2dphi(u1,phi,VOLT,CbpbO2,CpbO,u2) + jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO)) - (Djpbo2Dcpbo(CbpbO2,CpbO,u2,VOLT,phi) + DjpboDcpbo(u2,phi,VOLT,CpbO,CbpbO2))*GAM1*((om^-1)/(2*F))*(du2*jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO) + dphi*jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO))))*Djpbo2Dcpbo2(CbpbO2,CpbO,u2,VOLT,phi) + (-GAM1*((om^-1)/(2*F))*(du2*jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO) + dphi*jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO)) - GAM1*((om^-1)/(2*F))*DjpboDcpbo2(u2,phi,VOLT,CpbO,CbpbO2)*(1 - SIG1)^(-1)*((om^-1)/(2*F))*(du1*jpbO2du1(phi,VOLT) + du2*(jpbO2du2(u2,phi,VOLT,CbpbO2,CpbO) + jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO)) + dphi*(jpbO2dphi(u1,phi,VOLT,CbpbO2,CpbO,u2) + jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO)) - (Djpbo2Dcpbo(CbpbO2,CpbO,u2,VOLT,phi) + DjpboDcpbo(u2,phi,VOLT,CpbO,CbpbO2))*GAM1*((om^-1)/(2*F))*(du2*jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO) + dphi*jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO))))*Djpbo2Dcpbo(CbpbO2,CpbO,u2,VOLT,phi))

    -dt*v2*(1/F)*(du2*(jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO)) + dphi*(jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO)) + ((1 - SIG1)^(-1)*((om^-1)/(2*F))*(du1*jpbO2du1(phi,VOLT) + du2*(jpbO2du2(u2,phi,VOLT,CbpbO2,CpbO) + jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO)) + dphi*(jpbO2dphi(u1,phi,VOLT,CbpbO2,CpbO,u2) + jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO)) - (Djpbo2Dcpbo(CbpbO2,CpbO,u2,VOLT,phi) + DjpboDcpbo(u2,phi,VOLT,CpbO,CbpbO2))*GAM1*((om^-1)/(2*F))*(du2*jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO) + dphi*jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO))))*DjpboDcpbo2(u2,phi,VOLT,CpbO,CbpbO2) + (-GAM1*((om^-1)/(2*F))*(du2*jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO) + dphi*jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO)) - GAM1*((om^-1)/(2*F))*DjpboDcpbo2(u2,phi,VOLT,CpbO,CbpbO2)*(1 - SIG1)^(-1)*((om^-1)/(2*F))*(du1*jpbO2du1(phi,VOLT) + du2*(jpbO2du2(u2,phi,VOLT,CbpbO2,CpbO) + jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO)) + dphi*(jpbO2dphi(u1,phi,VOLT,CbpbO2,CpbO,u2) + jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO)) - (Djpbo2Dcpbo(CbpbO2,CpbO,u2,VOLT,phi) + DjpboDcpbo(u2,phi,VOLT,CpbO,CbpbO2))*GAM1*((om^-1)/(2*F))*(du2*jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO) + dphi*jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO))))*DjpboDcpbo(u2,phi,VOLT,CpbO,CbpbO2)) 

    -dt*v3*(du1*(jpbO2du1(phi,VOLT)) + du2*(jpbO2du2(u2,phi,VOLT,CbpbO2,CpbO)) + dphi*(jpbO2dphi(u1,phi,VOLT,CbpbO2,CpbO,u2)) + ((1 - SIG1)^(-1)*((om^-1)/(2*F))*(du1*jpbO2du1(phi,VOLT) + du2*(jpbO2du2(u2,phi,VOLT,CbpbO2,CpbO) + jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO)) + dphi*(jpbO2dphi(u1,phi,VOLT,CbpbO2,CpbO,u2) + jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO)) - (Djpbo2Dcpbo(CbpbO2,CpbO,u2,VOLT,phi) + DjpboDcpbo(u2,phi,VOLT,CpbO,CbpbO2))*GAM1*((om^-1)/(2*F))*(du2*jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO) + dphi*jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO))))*Djpbo2Dcpbo2(CbpbO2,CpbO,u2,VOLT,phi) + (-GAM1*((om^-1)/(2*F))*(du2*jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO) + dphi*jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO)) - GAM1*((om^-1)/(2*F))*DjpboDcpbo2(u2,phi,VOLT,CpbO,CbpbO2)*(1 - SIG1)^(-1)*((om^-1)/(2*F))*(du1*jpbO2du1(phi,VOLT) + du2*(jpbO2du2(u2,phi,VOLT,CbpbO2,CpbO) + jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO)) + dphi*(jpbO2dphi(u1,phi,VOLT,CbpbO2,CpbO,u2) + jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO)) - (Djpbo2Dcpbo(CbpbO2,CpbO,u2,VOLT,phi) + DjpboDcpbo(u2,phi,VOLT,CpbO,CbpbO2))*GAM1*((om^-1)/(2*F))*(du2*jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO) + dphi*jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO))))*Djpbo2Dcpbo(CbpbO2,CpbO,u2,VOLT,phi))

    -dt*v3*(du2*(jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO)) + dphi*(jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO)) + ((1 - SIG1)^(-1)*((om^-1)/(2*F))*(du1*jpbO2du1(phi,VOLT) + du2*(jpbO2du2(u2,phi,VOLT,CbpbO2,CpbO) + jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO)) + dphi*(jpbO2dphi(u1,phi,VOLT,CbpbO2,CpbO,u2) + jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO)) - (Djpbo2Dcpbo(CbpbO2,CpbO,u2,VOLT,phi) + DjpboDcpbo(u2,phi,VOLT,CpbO,CbpbO2))*GAM1*((om^-1)/(2*F))*(du2*jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO) + dphi*jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO))))*DjpboDcpbo2(u2,phi,VOLT,CpbO,CbpbO2) + (-GAM1*((om^-1)/(2*F))*(du2*jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO) + dphi*jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO)) - GAM1*((om^-1)/(2*F))*DjpboDcpbo2(u2,phi,VOLT,CpbO,CbpbO2)*(1 - SIG1)^(-1)*((om^-1)/(2*F))*(du1*jpbO2du1(phi,VOLT) + du2*(jpbO2du2(u2,phi,VOLT,CbpbO2,CpbO) + jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO)) + dphi*(jpbO2dphi(u1,phi,VOLT,CbpbO2,CpbO,u2) + jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO)) - (Djpbo2Dcpbo(CbpbO2,CpbO,u2,VOLT,phi) + DjpboDcpbo(u2,phi,VOLT,CpbO,CbpbO2))*GAM1*((om^-1)/(2*F))*(du2*jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO) + dphi*jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO))))*DjpboDcpbo(u2,phi,VOLT,CpbO,CbpbO2)) ) //side reaction part 2

    + on(1, du1=uin1-u1)

    + on(1, du2=uin2-u2)

    ;





problem dHeat2 (du1, du2, dphi, v1, v2, v3, solver="MUMPS_seq")//, solver="MUMPS") //the order matters: put your unknowns first, then your test functions

    =int2d(dom4)(

        ((2*(dt/dtold)+1)/((dt/dtold)+1))*du1*v1 //bilinear

        + ((2*(dt/dtold)+1)/((dt/dtold)+1))*du2*v2

        + dt*mu1*(dx(du1)*dx(v1) + dy(du1)*dy(v1))

        + 2*dt*mu1*(F/(R*T))*(u1*(dx(dphi)*dx(v1) + dy(dphi)*dy(v1)) + du1*(dx(phi)*dx(v1) + dy(phi)*dy(v1)))

        - dt*(6*V/(W^2))*x*(W-x)*(du1*dy(v1))

        + dt*mu2*(dx(du2)*dx(v2) + dy(du2)*dy(v2))

        + dt*mu2*(F/(R*T))*(u2*(dx(dphi)*dx(v2) + dy(dphi)*dy(v2)) + du2*(dx(phi)*dx(v2) + dy(phi)*dy(v2)))

        - dt*(6*V/(W^2))*x*(W-x)*(du2*dy(v2))

        + dt*F*(2*mu1-2*mu3)*(dx(du1)*dx(v3) + dy(du1)*dy(v3))

        + dt*F*(mu2-mu3)*(dx(du2)*dx(v3) + dy(du2)*dy(v3))

        + dt*(F^2/(R*T))*((4*mu1+2*mu3)*(u1*(dx(dphi)*dx(v3) + dy(dphi)*dy(v3)) + du1*(dx(phi)*dx(v3) + dy(phi)*dy(v3))) + (mu2+mu3)*(u2*(dx(dphi)*dx(v3) + dy(dphi)*dy(v3)) + du2*(dx(phi)*dx(v3) + dy(phi)*dy(v3))))

    )

    + int2d(dom4)( //linear

        ((2*(dt/dtold)+1)/((dt/dtold)+1))*u1*v1

        + ((2*(dt/dtold)+1)/((dt/dtold)+1))*u2*v2

        + dt*mu1*(dx(u1)*dx(v1) + dy(u1)*dy(v1))

        + 2*dt*mu1*(F/(R*T))*u1*(dx(phi)*dx(v1) + dy(phi)*dy(v1))

        - dt*(6*V/(W^2))*x*(W-x)*(u1*dy(v1))

        + dt*mu2*(dx(u2)*dx(v2) + dy(u2)*dy(v2))

        + dt*mu2*(F/(R*T))*u2*(dx(phi)*dx(v2) + dy(phi)*dy(v2))

        - dt*(6*V/(W^2))*x*(W-x)*(u2*dy(v2))

        + dt*F*(2*mu1-2*mu3)*(dx(u1)*dx(v3) + dy(u1)*dy(v3))

        + dt*F*(mu2-mu3)*(dx(u2)*dx(v3) + dy(u2)*dy(v3))

        + dt*(F^2/(R*T))*((4*mu1+2*mu3)*u1*(dx(phi)*dx(v3) + dy(phi)*dy(v3)) + (mu2+mu3)*u2*(dx(phi)*dx(v3) + dy(phi)*dy(v3)))

    //)

    //+ int2d(dom4)(

        -((dt/dtold)+1)*U1[Nstore-1]*v1 + (((dt/dtold)^2)/((dt/dtold)+1))*U1[Nstore-2]*v1

        -((dt/dtold)+1)*U2[Nstore-1]*v2 + (((dt/dtold)^2)/((dt/dtold)+1))*U2[Nstore-2]*v2   

    )

    + int1d(dom4, 3)(dt*(6*V/(W^2))*x*(W-x)*(v1*u1) + dt*(6*V/(W^2))*x*(W-x)*(v2*u2)) //linear


    - int1d(dom4, 2)(dt*(1/(2*F))*v1*(jpb(u1,phi,Cpb) + dCpbLin*DjpbDcpb(Cpb,phi)) 

    + dt*v3*(jpb(u1,phi,Cpb) + dCpbLin*DjpbDcpb(Cpb,phi)))


    + int1d(dom4, 4)(dt*(1/(2*F))*v1*(jpbO2(u1,phi,VOLT,CbpbO2,CpbO,u2) + dCbpbO2Lin*Djpbo2Dcpbo2(CbpbO2,CpbO,u2,VOLT,phi) + dCpbOLin*Djpbo2Dcpbo(CbpbO2,CpbO,u2,VOLT,phi)) 

    - dt*(2/F)*v2*(jpbO2(u1,phi,VOLT,CbpbO2,CpbO,u2) + dCbpbO2Lin*Djpbo2Dcpbo2(CbpbO2,CpbO,u2,VOLT,phi) + dCpbOLin*Djpbo2Dcpbo(CbpbO2,CpbO,u2,VOLT,phi)) 

    - dt*(1/F)*v2*(jpbO(u2,phi,VOLT,CbpbO2,CpbO) + dCbpbO2Lin*DjpboDcpbo2(u2,phi,VOLT,CpbO,CbpbO2) + dCpbOLin*DjpboDcpbo(u2,phi,VOLT,CpbO,CbpbO2)) 

    - dt*v3*(jpbO2(u1,phi,VOLT,CbpbO2,CpbO,u2) + dCbpbO2Lin*Djpbo2Dcpbo2(CbpbO2,CpbO,u2,VOLT,phi) + dCpbOLin*Djpbo2Dcpbo(CbpbO2,CpbO,u2,VOLT,phi))
    
    - dt*v3*(jpbO(u2,phi,VOLT,CbpbO2,CpbO) + dCbpbO2Lin*DjpboDcpbo2(u2,phi,VOLT,CpbO,CbpbO2) + dCpbOLin*DjpboDcpbo(u2,phi,VOLT,CpbO,CbpbO2)))



    + int1d(dom4, 3)(dt*(6*V/(W^2))*x*(W-x)*(v1*du1) + dt*(6*V/(W^2))*x*(W-x)*(v2*du2)) //bilinear
    

    - int1d(dom4, 2)(dt*(1/(2*F))*v1*(du1*(jpbdu1(phi)) + dphi*(jpbdphi(u1,phi,Cpb)) + (-(1 + ((om^-1)/(2*F))*DjpbDcpb(Cpb,phi))^(-1)*((om^-1)/(2*F))*(du1*jpbdu1(phi) + dphi*jpbdphi(u1,phi,Cpb)))*DjpbDcpb(Cpb,phi)) 
    
    + dt*v3*(du1*(jpbdu1(phi)) + dphi*(jpbdphi(u1,phi,Cpb)) + (-(1 + ((om^-1)/(2*F))*DjpbDcpb(Cpb,phi))^(-1)*((om^-1)/(2*F))*(du1*jpbdu1(phi) + dphi*jpbdphi(u1,phi,Cpb)))*DjpbDcpb(Cpb,phi)))


    + int1d(dom4, 4)(dt*(1/(2*F))*v1*(du1*(jpbO2du1(phi,VOLT)) + du2*(jpbO2du2(u2,phi,VOLT,CbpbO2,CpbO)) + dphi*(jpbO2dphi(u1,phi,VOLT,CbpbO2,CpbO,u2)) + ((1 - SIG1)^(-1)*((om^-1)/(2*F))*(du1*jpbO2du1(phi,VOLT) + du2*(jpbO2du2(u2,phi,VOLT,CbpbO2,CpbO) + jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO)) + dphi*(jpbO2dphi(u1,phi,VOLT,CbpbO2,CpbO,u2) + jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO)) - (Djpbo2Dcpbo(CbpbO2,CpbO,u2,VOLT,phi) + DjpboDcpbo(u2,phi,VOLT,CpbO,CbpbO2))*GAM1*((om^-1)/(2*F))*(du2*jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO) + dphi*jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO))))*Djpbo2Dcpbo2(CbpbO2,CpbO,u2,VOLT,phi) + (-GAM1*((om^-1)/(2*F))*(du2*jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO) + dphi*jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO)) - GAM1*((om^-1)/(2*F))*DjpboDcpbo2(u2,phi,VOLT,CpbO,CbpbO2)*(1 - SIG1)^(-1)*((om^-1)/(2*F))*(du1*jpbO2du1(phi,VOLT) + du2*(jpbO2du2(u2,phi,VOLT,CbpbO2,CpbO) + jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO)) + dphi*(jpbO2dphi(u1,phi,VOLT,CbpbO2,CpbO,u2) + jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO)) - (Djpbo2Dcpbo(CbpbO2,CpbO,u2,VOLT,phi) + DjpboDcpbo(u2,phi,VOLT,CpbO,CbpbO2))*GAM1*((om^-1)/(2*F))*(du2*jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO) + dphi*jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO))))*Djpbo2Dcpbo(CbpbO2,CpbO,u2,VOLT,phi))

    -dt*(2/F)*v2*(du1*(jpbO2du1(phi,VOLT)) + du2*(jpbO2du2(u2,phi,VOLT,CbpbO2,CpbO)) + dphi*(jpbO2dphi(u1,phi,VOLT,CbpbO2,CpbO,u2)) + ((1 - SIG1)^(-1)*((om^-1)/(2*F))*(du1*jpbO2du1(phi,VOLT) + du2*(jpbO2du2(u2,phi,VOLT,CbpbO2,CpbO) + jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO)) + dphi*(jpbO2dphi(u1,phi,VOLT,CbpbO2,CpbO,u2) + jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO)) - (Djpbo2Dcpbo(CbpbO2,CpbO,u2,VOLT,phi) + DjpboDcpbo(u2,phi,VOLT,CpbO,CbpbO2))*GAM1*((om^-1)/(2*F))*(du2*jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO) + dphi*jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO))))*Djpbo2Dcpbo2(CbpbO2,CpbO,u2,VOLT,phi) + (-GAM1*((om^-1)/(2*F))*(du2*jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO) + dphi*jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO)) - GAM1*((om^-1)/(2*F))*DjpboDcpbo2(u2,phi,VOLT,CpbO,CbpbO2)*(1 - SIG1)^(-1)*((om^-1)/(2*F))*(du1*jpbO2du1(phi,VOLT) + du2*(jpbO2du2(u2,phi,VOLT,CbpbO2,CpbO) + jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO)) + dphi*(jpbO2dphi(u1,phi,VOLT,CbpbO2,CpbO,u2) + jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO)) - (Djpbo2Dcpbo(CbpbO2,CpbO,u2,VOLT,phi) + DjpboDcpbo(u2,phi,VOLT,CpbO,CbpbO2))*GAM1*((om^-1)/(2*F))*(du2*jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO) + dphi*jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO))))*Djpbo2Dcpbo(CbpbO2,CpbO,u2,VOLT,phi))

