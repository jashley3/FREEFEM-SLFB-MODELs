        - dt*(6*V/(W^2))*x*(W-x)*(u2*dy(v2))

        + dt*F*(2*mu1-2*mu3)*(dx(u1)*dx(v3) + dy(u1)*dy(v3))

        + dt*F*(mu2-mu3)*(dx(u2)*dx(v3) + dy(u2)*dy(v3))

        + dt*(F^2/(R*T))*((4*mu1+2*mu3)*u1*(dx(phi)*dx(v3) + dy(phi)*dy(v3)) + (mu2+mu3)*u2*(dx(phi)*dx(v3) + dy(phi)*dy(v3)))

    //)

    //+ int2d(dom4)(

        -(((2*(dt/dtold)+1)/((dt/dtold)+1)) + (((dt/dtold)*(dtold/dtold2))/(1+(dtold/dtold2)+(dt/dtold)*(dtold/dtold2))))*U1[Nstore-1]*v1 - (((dt/dtold)/(1+(dt/dtold))) + (((dt/dtold)*(dtold/dtold2))/(1+(dtold/dtold2)+(dt/dtold)*(dtold/dtold2))) + (((dt/dtold)*((dtold/dtold2)^2)*(1+dt/dtold))/((1+(dtold/dtold2)+((dt/dtold)*(dtold/dtold2)))*(1+dtold/dtold2))))*(dt/dtold)*(U1[Nstore-1]-U1[Nstore-2])*v1 +(((dt/dtold)*((dtold/dtold2)^2)*(1+(dt/dtold)))/((1+(dtold/dtold2)+(dt/dtold)*(dtold/dtold2))*(1+(dtold/dtold2))))*(dt/dtold2)*(U1[Nstore-2]-U1[Nstore-3])*v1

        -(((2*(dt/dtold)+1)/((dt/dtold)+1)) + (((dt/dtold)*(dtold/dtold2))/(1+(dtold/dtold2)+(dt/dtold)*(dtold/dtold2))))*U2[Nstore-1]*v2 - (((dt/dtold)/(1+(dt/dtold))) + (((dt/dtold)*(dtold/dtold2))/(1+(dtold/dtold2)+(dt/dtold)*(dtold/dtold2))) + (((dt/dtold)*((dtold/dtold2)^2)*(1+dt/dtold))/((1+(dtold/dtold2)+((dt/dtold)*(dtold/dtold2)))*(1+dtold/dtold2))))*(dt/dtold)*(U2[Nstore-1]-U2[Nstore-2])*v2 +(((dt/dtold)*((dtold/dtold2)^2)*(1+(dt/dtold)))/((1+(dtold/dtold2)+(dt/dtold)*(dtold/dtold2))*(1+(dtold/dtold2))))*(dt/dtold2)*(U2[Nstore-2]-U2[Nstore-3])*v2   

    )

    + int1d(dom4, 3)(dt*(6*V/(W^2))*x*(W-x)*(v1*u1) + dt*(6*V/(W^2))*x*(W-x)*(v2*u2)) //linear


    - int1d(dom4, 2)(dt*(1/(2*F))*v1*(jpb(u1,phi,Cpb) + dCpbLin*DjpbDcpb(Cpb,phi)) 

