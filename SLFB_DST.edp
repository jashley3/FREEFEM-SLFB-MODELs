                        dt=dtmin;
                    }
                    t=timevals[timevals.n-1];

                    K2=1;
                    Krestart=1;
                    mrestart=m;

                    mcount=MC;

                    restartNum=restartNum+1;

                    

                    u1=U1[U1.n-1]; u2=U2[U2.n-1]; phi=PHI[PHI.n-1]; VOLT=voltvals[voltvals.n-1]; Cpb=CPB[Nstore-1]; CbpbO2=CPBO2[Nstore-1]; CpbO=CPBO[Nstore-1];
                    
                }
            }
            if(KcancelSim==1) break;
            if(K2==1) break;
            Icounter=Icounter+1;
            
        }
        if(KcancelSim==1) break;
        if(K2==1) break;
        
        




        cout<<"V="<<VOLT<<endl;

        cout<<"dV="<<dVOLT<<endl;

        cout<<"uin1="<<uin1<<endl;

        cout<<"uin2="<<uin2<<endl;

        cout<<"dt="<<dt<<endl;

        cout<<"|dV/dt| = "<<abs((voltvals[voltvals.n-1]-VOLT)/dt)<<endl;

        cout<<"dtmax="<<dtmax<<endl;

        cout<<"t="<<t<<endl;

        cout<<"dt/dtold="<<dt/dtold<<endl;

        cout<<"dtold/dtold2="<<dtold/dtold2<<endl;

        

        itot=i;



        real Lu1= u1[].linfty, Lu2=u2[].linfty, Lphi=phi[].linfty;
        err1 = du1[].linfty/(Lu1) + du2[].linfty/(Lu2) + dphi[].linfty/(Lphi);

        

        if(isNaN(err1)==1){

            if(dt==dtmin){
                KcancelSim=1;
                cout<<"ERROR E"<<endl;
                break;
            }

            m-=1;  
            dt=dt/stepsizeratio;
            //dt=dtmin;
            if(dt<dtmin){
                dt=dtmin;
            }
            t=timevals[timevals.n-1];

            K2=1;
            Krestart=1;
            mrestart=m;
            mcount=MC;
            restartNum=restartNum+1;
            u1=U1[U1.n-1]; u2=U2[U2.n-1]; phi=PHI[PHI.n-1]; VOLT=voltvals[voltvals.n-1]; Cpb=CPB[Nstore-1]; CbpbO2=CPBO2[Nstore-1]; CpbO=CPBO[Nstore-1];
            
        }
        if(KcancelSim==1) break;

        if(K2==1) break;




        
        if(i==0){
            errvals.resize(m+2);
            errvals[m+1] = err1;

        }
        

        cout<<i<<"err="<<err1<<endl;
        



        

    }

    
    if(KcancelSim==1) break;
    


    if(m>2 && K2==0){

        
        
        if(itot>1){
            dvoltErr = abs((((VOLT - voltvals[voltvals.n-1])/(t - timevals[timevals.n-1])) - ((voltvals[voltvals.n-1] - voltvals[voltvals.n-2])/(timevals[timevals.n-1] - timevals[timevals.n-2])))/(1e-20 + ((voltvals[voltvals.n-1] - voltvals[voltvals.n-2])/(timevals[timevals.n-1] - timevals[timevals.n-2]))));
            cout<<" - - - -"<<endl;
            cout<<"dvoltErr="<<dvoltErr<<endl;

            
            
            
            if(dvoltErr>0.4 && dt>dtmin && itot>5){
                //m-=1;  
                DT=DT/stepsizeratio;
                if(DT<dtmin){
                    DT=dtmin;
                }

                mcount=MC;

               
            }
            

            if(dvoltErr<=0.3  && mcount==0){ 
                DT=DT*stepsizeratio;  
                if(DT>dtmax){  
                    DT=dtmax;
                }
            }
        }


       
        if(itot<=5){
            DT=DT*2;
            if(DT>dtmax){
                DT=dtmax;
            }
        }
    }

   

    if(K2==0){

        dt=DT;

        if(mcount>0){
            mcount=mcount-1;
        }

        if(mRestart>0){
            mRestart=mRestart-1;
        }

        


        Vh4bound CpbWall2ver2 = Cpb; //interpolates Cpb calculated above onto wall2 only     
        
        real sumCpb=0;
        for(int iii=0; iii<=(Vh4bound.ndof -1); iii++){
            sumCpb+=CpbWall2ver2[][iii];
        }
        real CpbAv=(sumCpb)/(Vh4bound.ndof);
        cout<<"----"<<endl;
        cout<<"Average cumulative Pb concentration="<<CpbAv<<endl;
        cout<<"----"<<endl;



        

        Vh4ver2bound CbpbO2Wall1ver2 = CbpbO2;
        Vh4ver2bound CpbOWall1 = CpbO;


        real sumbCpbO2=0;
        for(int iii=0; iii<=(Vh4ver2bound.ndof -1); iii++){
            sumbCpbO2+=CbpbO2Wall1ver2[][iii];
        }
        real CbpbO2Av=(sumbCpbO2)/(Vh4ver2bound.ndof);
       cout<<"Average cumulative PbO2 concentration="<<CbpbO2Av<<endl;
        
        cout<<"----"<<endl;

        
        real sumCpbO=0;
        for(int iii=0; iii<=(Vh4ver2bound.ndof -1); iii++){
            sumCpbO+=CpbOWall1[][iii];
        }
        real CpbOAv=(sumCpbO)/(Vh4ver2bound.ndof);
        cout<<"Average cumulative PbO concentration="<<CpbOAv<<endl;

        cout<<"----"<<endl;
        

        Krestart=0;


        itotvals.resize(m+2);
        itotvals[m+1] = itot;

   
        


        //To prevent overshoot of the specified end time
        if(t+dtmax>ttotal){
            while(t+dtmax>ttotal){
                dtmax=dtmax*(1.5)^(-1);
                if(dtmax<dtmin){
                    dtmax=dtmin;
                    break;
                }
            }
        }



        if(dt>dtmax){   //Make sure dt does not exceed dtmax after adjusting dtmax
            dt=dtmax;
        }
        if(dt<dtmin){   
            dt=dtmin*2;
        }



     
        


   



        

        cout<<" "<<endl;
        cout<<" "<<endl;
  
        cout<<"---"<<endl;

        cout<<"Total number of iterations needed for convergence = "<<itot<<endl;

        cout<<" "<<endl;

        

        cout<<"CPU time = "<<clock()<<endl;

        cout<<" "<<endl;

        cout<<" "<<endl;

        cout<<"---"<<endl;






        //Store latest Nstore solutions
        for (int G=0; G<=Nstore-1; G++){
            if(G==Nstore-1){
                U1[G]=u1; U2[G]=u2; PHI[G]=phi; CPB[G]=Cpb; CPBO2[G]=CbpbO2; CPBO[G]=CpbO; UIN1[G]=uin1; UIN2[G]=uin2;
                break;
            }
            U1[G]=U1[G+1]; U2[G]=U2[G+1]; PHI[G]=PHI[G+1]; CPB[G]=CPB[G+1]; CPBO2[G]=CPBO2[G+1]; CPBO[G]=CPBO[G+1]; UIN1[G]=UIN1[G+1]; UIN2[G]=UIN2[G+1];
        }





        /*plot(phi, value=true, wait=false); //fill=true,



        plot(u2, value=true, wait=true); //fill=true,

        

        plot(u1, value=true, wait=true); //fill=true,*/

        
       
        




        
        dvoltErrvals.resize(m+2);
        dvoltErrvals[m+1]=dvoltErr;
        
        
        timevals.resize(m+2);
        timevals[m+1] = t;

        
        voltvals.resize(m+2);
        voltvals[m+1]=VOLT;

        
        CpbAvVals.resize(m+2);
        CpbAvVals[m+1]=CpbAv;

        
        CbpbO2AvVals.resize(m+2);
        CbpbO2AvVals[m+1]=CbpbO2Av;


        CpbOAvVals.resize(m+2);
        CpbOAvVals[m+1]=CpbOAv;


        uin1AvVals.resize(m+2);
        uin1AvVals[m+1]=uin1;//u1inAv;

        uin2AvVals.resize(m+2);
        uin2AvVals[m+1]=uin2;//u2inAv;


        outintvals1.resize(m+2);
        outintvals1[m+1]=int1d(dom4,3)((6*V/(W^2))*x*(W-x)*u1);


        outintvals2.resize(m+2);
        outintvals2[m+1]=int1d(dom4,3)((6*V/(W^2))*x*(W-x)*u2);


        c1normvals.resize(m+2);
        c1normvals[m+1]=int2d(dom4)(u1)/(W*L);//u1[].l2;


        c2normvals.resize(m+2);
        c2normvals[m+1]=int2d(dom4)(u2)/(W*L);//u2[].l2;


        phinormvals.resize(m+2);
        phinormvals[m+1]=int2d(dom4)(phi)/(W*L);//phi[].l2;//*/
                


        kappavalsA.resize(m+2);
        kappavalsA[m+1]=(1/(L*W))*int2d(dom4)( (F^2/(R*T))*(4*mu1*u1 + mu2*u2 + mu3*(2*u1+u2)) );

        D10valsA.resize(m+2);
        D10valsA[m+1]=(1/(L*W))*int2d(dom4)(R*T*u1/mu1); 

        D20valsA.resize(m+2);
        D20valsA[m+1]=(1/(L*W))*int2d(dom4)(R*T*u2/mu2); 

        D30valsA.resize(m+2);
        D30valsA[m+1]=(1/(L*W))*int2d(dom4)(R*T*(2*u1+u2)/mu3); 

        t1vals.resize(m+2);
        t1vals[m+1]=(1/(L*W))*int2d(dom4)( (z1^2*u1*F^2*mu1)/(((F^2/(R*T))*(4*mu1*u1 + mu2*u2 + mu3*(2*u1+u2)))*R*T) ); 

        t2vals.resize(m+2);
        t2vals[m+1]=(1/(L*W))*int2d(dom4)( (z2^2*u2*F^2*mu2)/(((F^2/(R*T))*(4*mu1*u1 + mu2*u2 + mu3*(2*u1+u2)))*R*T) ); 

        t3vals.resize(m+2);
        t3vals[m+1]=(1/(L*W))*int2d(dom4)( (z3^2*(2*u1+u2)*F^2*mu3)/(((F^2/(R*T))*(4*mu1*u1 + mu2*u2 + mu3*(2*u1+u2)))*R*T) ); 

       


        

        VOLTfile.precision(12);
        VOLTfile << voltvals[voltvals.n-1]  <<endl;
        VOLTfile.flush;

        
        Timefile.precision(12);
        Timefile << timevals[timevals.n-1] <<endl;
        Timefile.flush;

      
        C1normfile.precision(12);
        C1normfile << c1normvals[c1normvals.n-1]  <<endl;
        C1normfile.flush;


        C2normfile.precision(12);    
        C2normfile << c2normvals[c2normvals.n-1] <<endl;
        C2normfile.flush;


        phinormfile.precision(12);
        phinormfile << phinormvals[phinormvals.n-1]  <<endl;
        phinormfile.flush;
     

        outint1file.precision(12);
        outint1file << outintvals1[outintvals1.n-1]  <<endl;
        outint1file.flush;

   
        dvoltErrfile.precision(12);
        dvoltErrfile << dvoltErrvals[dvoltErrvals.n-1]  <<endl;
        dvoltErrfile.flush;
     

        itotvalsfile.precision(12);
        itotvalsfile << itotvals[itotvals.n-1]  <<endl;
        itotvalsfile.flush;


        err1file.precision(12);
        err1file << errvals[errvals.n-1]  <<endl;
        err1file.flush;


        Cpbfile.precision(12);
        Cpbfile << CpbAvVals[CpbAvVals.n-1]  <<endl;
        Cpbfile.flush;


        Cpbo2file.precision(12);
        Cpbo2file << CbpbO2AvVals[CbpbO2AvVals.n-1]  <<endl;
        Cpbo2file.flush;

        
        Cpbofile.precision(12);
        Cpbofile << CpbOAvVals[CpbOAvVals.n-1]  <<endl;
        Cpbofile.flush;


        uin1file.precision(12);
        uin1file << uin1AvVals[uin1AvVals.n-1]  <<endl;
        uin1file.flush;


        uin2file.precision(12);
        uin2file << uin2AvVals[uin2AvVals.n-1]  <<endl;
        uin2file.flush;


        kappafile.precision(12);
        kappafile << kappavalsA[kappavalsA.n-1]  <<endl;
        kappafile.flush;


        D10file.precision(12);
        D10file << D10valsA[D10valsA.n-1]  <<endl;
        D10file.flush;


        D20file.precision(12);
        D20file << D20valsA[D20valsA.n-1]  <<endl;
        D20file.flush;


        D30file.precision(12);
        D30file << D30valsA[D30valsA.n-1]  <<endl;
        D30file.flush;


        t1file.precision(12);
        t1file << t1vals[t1vals.n-1]  <<endl;
        t1file.flush;


        t2file.precision(12);
        t2file << t2vals[t2vals.n-1]  <<endl;
        t2file.flush;


        t3file.precision(12);
        t3file << t3vals[t3vals.n-1]  <<endl;
        t3file.flush;


        // int[int] orderOut=[1];
        // if(m==100 || m==10 || m==50 || m==120 || m==90 ){
        //     string ttt=t;
        //     savevtk("phi_"+ttt+".vtu",dom4, phi, dataname="phi", order=orderOut);
        //     savevtk("c1_"+ttt+".vtu",dom4, u1, dataname="c1", order=orderOut);
        //     savevtk("c2_"+ttt+".vtu",dom4, u2, dataname="c2", order=orderOut);
        // }
    

            

        
        // real[int] yplot = [0.005, 0.01, 0.03, 0.05, 0.07, 0.09, 0.1];

        // int nplot = 200;

        // ofstream fout("c_profiles.dat");

        // for (int j = 0; j < yplot.n; j++)
        // {
        //     real yy = yplot[j];

        //     for (int i = 0; i <= nplot; i++)
        //     {
        //         real xx = W*i/nplot;

        //         fout << xx << " "
        //             << yy << " "
        //             << u1(xx,yy) << endl;
        //     }

        //     fout << endl;  // blank line between profiles
        // }

        // fout.flush;

        




        

        real IBETApbo2=D*int1d(dom4, 4)(jpbO2(u1,phi,VOLT,CbpbO2,CpbO,u2));

        real IpboBETA=D*int1d(dom4, 4)(jpbO(u2,phi,VOLT,CbpbO2,CpbO));

        

        cout<<"Current consumed by main +ve electrode reaction = "<<IBETApbo2<<endl;

        cout<<" "<<endl;

        cout<<"Current consumed by side +ve electrode reaction = "<<IpboBETA<<endl;

        cout<<"---"<<endl;



        
        Vh4bound u1wall2=u1;

        Vh4bound u2wall2=u2;



        Vh4ver2bound u1wall1=u1;

        Vh4ver2bound u2wall1=u2;




        if(u1wall2[].max<=0 && Iapp(t)>0){

            cout<<"Pb2+ conc. depleted along negative electrode"<<endl;

            break;

        }



        if(u1wall1[].max<=0 && Iapp(t)>0){

            cout<<"Pb2+ conc. depleted along positive electrode"<<endl;

            break;

        }



        if(u2wall1[].max<=0 && Iapp(t)<0){

            cout<<"H+ conc. depleted along positive electrode"<<endl;

            break;

        }



        if(u2wall2[].max<=0 && Iapp(t)<0){

            cout<<"H+ conc. depleted along negative electrode"<<endl;

            break;

        }

    
    }


}


if(KcancelSim==1){

    cout<<"              ---                  "<<endl;
    cout<<"Solver failed to converge within the specified tolerances. Here are some suggestions:"<<endl;
    cout<<" "<<endl;
    cout<<"1) Try lowering dtmin."<<endl;
    cout<<" "<<endl;
    cout<<"2) If m=0, check that the initial guesses for phi and VOLT are reasonable. It may require some trial and error."<<endl;
    //cout<<"3) If convergence failure occurs when approaching surface concentration depletion of reactants along the electrodes, it is likely caused by the singul"
    cout<<" "<<endl;
    cout<<"3) Try loosening the tolerance on itot."<<endl;
    cout<<" "<<endl;
    cout<<"4) When reactants along the electrodes approach depletion, a singularity will begin to form in the solution which can cause the solver to fail, particularly if the timestep is too large."<<endl;
    cout<<"In this case, the user could try: 1) Lowering dtmin, 2) Shorten the discharge period, 3) Adjust solver tolerances; stricter dt selection will enable better resolution of singularities during deep discharge"<<endl;
    cout<<" "<<endl;
    cout<<"5) A singularity in the solution will form when reacting ion concentrations begin to deplete next to the electrodes. This will occur if the cycle time is particularly long or if"<<endl;
    cout<<"the applied current is very high."<<endl;
    cout<<"              ---                  "<<endl;

}


if(KcancelSim==0){

    cout<<"              ---                  "<<endl;
    cout<<"--- Simulation reached the end --- "<<endl;
    cout<<"              ---                  "<<endl;

  



}





