problem dHeat3 (du1, du2, dphi, v1, v2, v3, solver="MUMPS_seq")//, solver="MUMPS") //the order matters: put your unknowns first, then your test functions

    =int2d(dom4)(

        (((2*(dt/dtold)+1)/((dt/dtold)+1)) + (((dt/dtold)*(dtold/dtold2))/(1+(dtold/dtold2)+(dt/dtold)*(dtold/dtold2))))*du1*v1 //bilinear

        + (((2*(dt/dtold)+1)/((dt/dtold)+1)) + (((dt/dtold)*(dtold/dtold2))/(1+(dtold/dtold2)+(dt/dtold)*(dtold/dtold2))))*du2*v2

        + dt*mu1*(dx(du1)*dx(v1) + dy(du1)*dy(v1))

        + 2*dt*mu1*(F/(R*T))*(u1*(dx(dphi)*dx(v1) + dy(dphi)*dy(v1)) + du1*(dx(phi)*dx(v1) + dy(phi)*dy(v1)))

        - dt*(6*V/(W^2))*x*(W-x)*(du1*dy(v1))

        + dt*mu2*(dx(du2)*dx(v2) + dy(du2)*dy(v2))

        + dt*mu2*(F/(R*T))*(u2*(dx(dphi)*dx(v2) + dy(dphi)*dy(v2)) + du2*(dx(phi)*dx(v2) + dy(phi)*dy(v2)))

        - dt*(6*V/(W^2))*x*(W-x)*(du2*dy(v2))

        + dt*F*(2*mu1-2*mu3)*(dx(du1)*dx(v3) + dy(du1)*dy(v3))

        + dt*F*(mu2-mu3)*(dx(du2)*dx(v3) + dy(du2)*dy(v3))

        + dt*(F^2/(R*T))*((4*mu1+2*mu3)*(u1*(dx(dphi)*dx(v3) + dy(dphi)*dy(v3)) + du1*(dx(phi)*dx(v3) + dy(phi)*dy(v3))) + (mu2+mu3)*(u2*(dx(dphi)*dx(v3) + dy(dphi)*dy(v3)) + du2*(dx(phi)*dx(v3) + dy(phi)*dy(v3))))

    )

    + int2d(dom4)( //linear

        (((2*(dt/dtold)+1)/((dt/dtold)+1)) + (((dt/dtold)*(dtold/dtold2))/(1+(dtold/dtold2)+(dt/dtold)*(dtold/dtold2))))*u1*v1

        + (((2*(dt/dtold)+1)/((dt/dtold)+1)) + (((dt/dtold)*(dtold/dtold2))/(1+(dtold/dtold2)+(dt/dtold)*(dtold/dtold2))))*u2*v2

        + dt*mu1*(dx(u1)*dx(v1) + dy(u1)*dy(v1))

        + 2*dt*mu1*(F/(R*T))*u1*(dx(phi)*dx(v1) + dy(phi)*dy(v1))

