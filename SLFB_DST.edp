    + int1d(dom4, 3)(dt*(6*V/(W^2))*x*(W-x)*(v1*du1) + dt*(6*V/(W^2))*x*(W-x)*(v2*du2)) //bilinear
    

    - int1d(dom4, 2)(dt*(1/(2*F))*v1*(du1*(jpbdu1(phi)) + dphi*(jpbdphi(u1,phi,Cpb)) + (-(1 + ((om^-1)/(2*F))*DjpbDcpb(Cpb,phi))^(-1)*((om^-1)/(2*F))*(du1*jpbdu1(phi) + dphi*jpbdphi(u1,phi,Cpb)))*DjpbDcpb(Cpb,phi)) 
    
    + dt*v3*(du1*(jpbdu1(phi)) + dphi*(jpbdphi(u1,phi,Cpb)) + (-(1 + ((om^-1)/(2*F))*DjpbDcpb(Cpb,phi))^(-1)*((om^-1)/(2*F))*(du1*jpbdu1(phi) + dphi*jpbdphi(u1,phi,Cpb)))*DjpbDcpb(Cpb,phi)))


    + int1d(dom4, 4)(dt*(1/(2*F))*v1*(du1*(jpbO2du1(phi,VOLT)) + du2*(jpbO2du2(u2,phi,VOLT,CbpbO2,CpbO)) + dphi*(jpbO2dphi(u1,phi,VOLT,CbpbO2,CpbO,u2)) + ((1 - SIG1)^(-1)*((om^-1)/(2*F))*(du1*jpbO2du1(phi,VOLT) + du2*(jpbO2du2(u2,phi,VOLT,CbpbO2,CpbO) + jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO)) + dphi*(jpbO2dphi(u1,phi,VOLT,CbpbO2,CpbO,u2) + jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO)) - (Djpbo2Dcpbo(CbpbO2,CpbO,u2,VOLT,phi) + DjpboDcpbo(u2,phi,VOLT,CpbO,CbpbO2))*GAM1*((om^-1)/(2*F))*(du2*jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO) + dphi*jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO))))*Djpbo2Dcpbo2(CbpbO2,CpbO,u2,VOLT,phi) + (-GAM1*((om^-1)/(2*F))*(du2*jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO) + dphi*jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO)) - GAM1*((om^-1)/(2*F))*DjpboDcpbo2(u2,phi,VOLT,CpbO,CbpbO2)*(1 - SIG1)^(-1)*((om^-1)/(2*F))*(du1*jpbO2du1(phi,VOLT) + du2*(jpbO2du2(u2,phi,VOLT,CbpbO2,CpbO) + jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO)) + dphi*(jpbO2dphi(u1,phi,VOLT,CbpbO2,CpbO,u2) + jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO)) - (Djpbo2Dcpbo(CbpbO2,CpbO,u2,VOLT,phi) + DjpboDcpbo(u2,phi,VOLT,CpbO,CbpbO2))*GAM1*((om^-1)/(2*F))*(du2*jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO) + dphi*jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO))))*Djpbo2Dcpbo(CbpbO2,CpbO,u2,VOLT,phi))

    -dt*(2/F)*v2*(du1*(jpbO2du1(phi,VOLT)) + du2*(jpbO2du2(u2,phi,VOLT,CbpbO2,CpbO)) + dphi*(jpbO2dphi(u1,phi,VOLT,CbpbO2,CpbO,u2)) + ((1 - SIG1)^(-1)*((om^-1)/(2*F))*(du1*jpbO2du1(phi,VOLT) + du2*(jpbO2du2(u2,phi,VOLT,CbpbO2,CpbO) + jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO)) + dphi*(jpbO2dphi(u1,phi,VOLT,CbpbO2,CpbO,u2) + jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO)) - (Djpbo2Dcpbo(CbpbO2,CpbO,u2,VOLT,phi) + DjpboDcpbo(u2,phi,VOLT,CpbO,CbpbO2))*GAM1*((om^-1)/(2*F))*(du2*jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO) + dphi*jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO))))*Djpbo2Dcpbo2(CbpbO2,CpbO,u2,VOLT,phi) + (-GAM1*((om^-1)/(2*F))*(du2*jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO) + dphi*jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO)) - GAM1*((om^-1)/(2*F))*DjpboDcpbo2(u2,phi,VOLT,CpbO,CbpbO2)*(1 - SIG1)^(-1)*((om^-1)/(2*F))*(du1*jpbO2du1(phi,VOLT) + du2*(jpbO2du2(u2,phi,VOLT,CbpbO2,CpbO) + jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO)) + dphi*(jpbO2dphi(u1,phi,VOLT,CbpbO2,CpbO,u2) + jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO)) - (Djpbo2Dcpbo(CbpbO2,CpbO,u2,VOLT,phi) + DjpboDcpbo(u2,phi,VOLT,CpbO,CbpbO2))*GAM1*((om^-1)/(2*F))*(du2*jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO) + dphi*jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO))))*Djpbo2Dcpbo(CbpbO2,CpbO,u2,VOLT,phi))

    -dt*v2*(1/F)*(du2*(jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO)) + dphi*(jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO)) + ((1 - SIG1)^(-1)*((om^-1)/(2*F))*(du1*jpbO2du1(phi,VOLT) + du2*(jpbO2du2(u2,phi,VOLT,CbpbO2,CpbO) + jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO)) + dphi*(jpbO2dphi(u1,phi,VOLT,CbpbO2,CpbO,u2) + jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO)) - (Djpbo2Dcpbo(CbpbO2,CpbO,u2,VOLT,phi) + DjpboDcpbo(u2,phi,VOLT,CpbO,CbpbO2))*GAM1*((om^-1)/(2*F))*(du2*jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO) + dphi*jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO))))*DjpboDcpbo2(u2,phi,VOLT,CpbO,CbpbO2) + (-GAM1*((om^-1)/(2*F))*(du2*jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO) + dphi*jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO)) - GAM1*((om^-1)/(2*F))*DjpboDcpbo2(u2,phi,VOLT,CpbO,CbpbO2)*(1 - SIG1)^(-1)*((om^-1)/(2*F))*(du1*jpbO2du1(phi,VOLT) + du2*(jpbO2du2(u2,phi,VOLT,CbpbO2,CpbO) + jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO)) + dphi*(jpbO2dphi(u1,phi,VOLT,CbpbO2,CpbO,u2) + jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO)) - (Djpbo2Dcpbo(CbpbO2,CpbO,u2,VOLT,phi) + DjpboDcpbo(u2,phi,VOLT,CpbO,CbpbO2))*GAM1*((om^-1)/(2*F))*(du2*jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO) + dphi*jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO))))*DjpboDcpbo(u2,phi,VOLT,CpbO,CbpbO2)) 

    -dt*v3*(du1*(jpbO2du1(phi,VOLT)) + du2*(jpbO2du2(u2,phi,VOLT,CbpbO2,CpbO)) + dphi*(jpbO2dphi(u1,phi,VOLT,CbpbO2,CpbO,u2)) + ((1 - SIG1)^(-1)*((om^-1)/(2*F))*(du1*jpbO2du1(phi,VOLT) + du2*(jpbO2du2(u2,phi,VOLT,CbpbO2,CpbO) + jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO)) + dphi*(jpbO2dphi(u1,phi,VOLT,CbpbO2,CpbO,u2) + jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO)) - (Djpbo2Dcpbo(CbpbO2,CpbO,u2,VOLT,phi) + DjpboDcpbo(u2,phi,VOLT,CpbO,CbpbO2))*GAM1*((om^-1)/(2*F))*(du2*jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO) + dphi*jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO))))*Djpbo2Dcpbo2(CbpbO2,CpbO,u2,VOLT,phi) + (-GAM1*((om^-1)/(2*F))*(du2*jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO) + dphi*jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO)) - GAM1*((om^-1)/(2*F))*DjpboDcpbo2(u2,phi,VOLT,CpbO,CbpbO2)*(1 - SIG1)^(-1)*((om^-1)/(2*F))*(du1*jpbO2du1(phi,VOLT) + du2*(jpbO2du2(u2,phi,VOLT,CbpbO2,CpbO) + jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO)) + dphi*(jpbO2dphi(u1,phi,VOLT,CbpbO2,CpbO,u2) + jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO)) - (Djpbo2Dcpbo(CbpbO2,CpbO,u2,VOLT,phi) + DjpboDcpbo(u2,phi,VOLT,CpbO,CbpbO2))*GAM1*((om^-1)/(2*F))*(du2*jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO) + dphi*jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO))))*Djpbo2Dcpbo(CbpbO2,CpbO,u2,VOLT,phi))

    -dt*v3*(du2*(jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO)) + dphi*(jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO)) + ((1 - SIG1)^(-1)*((om^-1)/(2*F))*(du1*jpbO2du1(phi,VOLT) + du2*(jpbO2du2(u2,phi,VOLT,CbpbO2,CpbO) + jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO)) + dphi*(jpbO2dphi(u1,phi,VOLT,CbpbO2,CpbO,u2) + jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO)) - (Djpbo2Dcpbo(CbpbO2,CpbO,u2,VOLT,phi) + DjpboDcpbo(u2,phi,VOLT,CpbO,CbpbO2))*GAM1*((om^-1)/(2*F))*(du2*jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO) + dphi*jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO))))*DjpboDcpbo2(u2,phi,VOLT,CpbO,CbpbO2) + (-GAM1*((om^-1)/(2*F))*(du2*jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO) + dphi*jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO)) - GAM1*((om^-1)/(2*F))*DjpboDcpbo2(u2,phi,VOLT,CpbO,CbpbO2)*(1 - SIG1)^(-1)*((om^-1)/(2*F))*(du1*jpbO2du1(phi,VOLT) + du2*(jpbO2du2(u2,phi,VOLT,CbpbO2,CpbO) + jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO)) + dphi*(jpbO2dphi(u1,phi,VOLT,CbpbO2,CpbO,u2) + jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO)) - (Djpbo2Dcpbo(CbpbO2,CpbO,u2,VOLT,phi) + DjpboDcpbo(u2,phi,VOLT,CpbO,CbpbO2))*GAM1*((om^-1)/(2*F))*(du2*jpbOdu2(u2,phi,VOLT,CbpbO2,CpbO) + dphi*jpbOdphi(u2,phi,VOLT,CbpbO2,CpbO))))*DjpboDcpbo(u2,phi,VOLT,CpbO,CbpbO2)) ) //side reaction part 2


    + on(1, du1=uin1-u1)

    + on(1, du2=uin2-u2)

    ;


//*/




//Initial conditions: concentrations of all species are uniform in space

real t=0; //Initialise time



u1=u1initial;  //Initial value for Newt. iteration (initial guess. In this case, we simply take it to be the value of the solution at t=0.)
uin1=u1[].max;
U1[Nstore-1]=u1;
U1[Nstore-2]=u1;
U1[Nstore-3]=u1;
UIN1[Nstore-1]=u1;
UIN1[Nstore-2]=u1;
UIN1[Nstore-3]=u1;


u2=u2initial;
uin2=u2[].max;
U2[Nstore-1]=u2;
U2[Nstore-2]=u2;
U2[Nstore-3]=u2;
UIN2[Nstore-1]=u2;
UIN2[Nstore-2]=u2;
UIN2[Nstore-3]=u2;


phi=phiguess; //starting guess for phi in Newt iteration/initial value for phi   
PHI[Nstore-1]=phi;
PHI[Nstore-2]=phi;
PHI[Nstore-3]=phi;


//Start with bare electrodes
Cpb=Cpbinitial;
CPB[Nstore-1]=Cpb;
CPB[Nstore-2]=Cpb;
CPB[Nstore-3]=Cpb;
dCpb=0;


CbpbO2=Cpbo2initial;
CPBO2[Nstore-1]=CbpbO2; 
CPBO2[Nstore-2]=CbpbO2; 
CPBO2[Nstore-3]=CbpbO2; 
dCbpbO2=0;


CpbO=Cpboinitial;
CPBO[Nstore-1]=CpbO; 
CPBO[Nstore-2]=CpbO; 
CPBO[Nstore-3]=CpbO; 
dCpbO=0;






//Integers used when a step fails
int K2=0;
int Krestart=0;
int KcancelSim=0;









VOLT=VOLTguess; //Initial guess of voltage

real Ineg = D*int1d(dom4, 2)(jpb(u1,phi,Cpb)); //Current at the negative electrode
real InegPrev;

real I = D*int1d(dom4, 4)(jpbO2(u1,phi,VOLT,CbpbO2,CpbO,u2)+jpbO(u2,phi,VOLT,CbpbO2,CpbO)); //Current at the positive electrode
real Iprev;




int mrestart;

int itot;



dt=dtmin; dtold=dtmin; dtold2=dtmin; dtold3=dtmin;
DT=dt;



t=t-dt; 





real[int] mvals; 
int m=-1;  

mvals.resize(m+2);
mvals[m+1]=m;

timevals.resize(m+2);
timevals[m+1] = t;

voltvals.resize(m+2);
voltvals[m+1]=VOLT;

dvoltErrvals.resize(m+2);
dvoltErrvals[m+1]=0;

CpbAvVals.resize(m+2);
CpbAvVals[m+1]=0;

CbpbO2AvVals.resize(m+2);
CbpbO2AvVals[m+1]=0;

CpbOAvVals.resize(m+2);
CpbOAvVals[m+1]=1;

itotvals.resize(m+2);
itotvals[m+1] = 0;

errvals.resize(m+2);
errvals[m+1] = 0;

uin1AvVals.resize(m+2);
uin1AvVals[m+1]=1500;

uin2AvVals.resize(m+2);
uin2AvVals[m+1]=1000;

outintvals1.resize(m+2);
outintvals1[m+1]=int1d(dom4,3)((6*V/(W^2))*x*(W-x)*u1);

outintvals2.resize(m+2);
outintvals2[m+1]=int1d(dom4,3)((6*V/(W^2))*x*(W-x)*u2);

c1normvals.resize(m+2);
c1normvals[m+1]=int2d(dom4)(u1)/(W*L);//u1[].l2;

c2normvals.resize(m+2);
c2normvals[m+1]=int2d(dom4)(u2)/(W*L);//u2[].l2;

phinormvals.resize(m+2);
phinormvals[m+1]=int2d(dom4)(phi)/(W*L);//phi[].l2;




kappavalsA.resize(m+2);
kappavalsA[m+1]=(1/(L*W))*int2d(dom4)( (F^2/(R*T))*(4*mu1*u1 + mu2*u2 + mu3*(2*u1+u2)) );

D10valsA.resize(m+2);
D10valsA[m+1]=(1/(L*W))*int2d(dom4)(R*T*u1/mu1); 

D20valsA.resize(m+2);
D20valsA[m+1]=(1/(L*W))*int2d(dom4)(R*T*u2/mu2); 

D30valsA.resize(m+2);
D30valsA[m+1]=(1/(L*W))*int2d(dom4)(R*T*(2*u1+u2)/mu3); 

t1vals.resize(m+2);
t1vals[m+1]=(1/(L*W))*int2d(dom4)( (z1^2*u1*F^2*mu1)/(((F^2/(R*T))*(4*mu1*u1 + mu2*u2 + mu3*(2*u1+u2)))*R*T) ); 

t2vals.resize(m+2);
t2vals[m+1]=(1/(L*W))*int2d(dom4)( (z2^2*u2*F^2*mu2)/(((F^2/(R*T))*(4*mu1*u1 + mu2*u2 + mu3*(2*u1+u2)))*R*T) ); 

t3vals.resize(m+2);
t3vals[m+1]=(1/(L*W))*int2d(dom4)( (z3^2*(2*u1+u2)*F^2*mu3)/(((F^2/(R*T))*(4*mu1*u1 + mu2*u2 + mu3*(2*u1+u2)))*R*T) ); 





real dvoltErr;

int mcount=0;

int mRestart=0;

int iBP=0;

int restartNum=0;






ofstream VOLTfile("voltvals1.txt"); //.txt
ofstream Timefile("timevals1.txt");
ofstream C1normfile("c1norm.txt"); //.txt
ofstream C2normfile("c2norm.txt"); //.txt
ofstream phinormfile("phinorm.txt"); //.txt
ofstream outint1file("outint1.txt"); //.txt
ofstream dvoltErrfile("dvoltErr.txt"); //.txt
ofstream itotvalsfile("itotvals1.txt");
ofstream err1file("err1.txt");
ofstream Cpbfile("CpbAvVals.txt"); //.txt
ofstream Cpbo2file("CbpbO2AvVals.txt");
ofstream Cpbofile("CpbOAvVals.txt");
ofstream uin1file("uin1AvVals.txt");
ofstream uin2file("uin2AvVals.txt");
ofstream kappafile("kappaA.txt");
ofstream D10file("D10A.txt");
ofstream D20file("D20A.txt");
ofstream D30file("D30A.txt");
ofstream t1file("t1.txt");
ofstream t2file("t2.txt");
ofstream t3file("t3.txt");



while (t<ttotal){ //Time loop

    cout<<" "<<endl;
    cout<<" "<<endl;
    cout<<" "<<endl;
    cout<<" "<<endl;
    cout<<" "<<endl;
    cout<<" "<<endl;
    cout<<" "<<endl;
    cout<<"------------"<<endl;
    cout<<"---timestep begins---"<<endl;
    cout<<"------------"<<endl;
    cout<<"Iapp="<<Iapp(t)<<endl;
    cout<<"dt="<<dt<<endl;
    cout<<"restarts="<<restartNum<<endl;

    m=m+1;
    mvals.resize(m+2);
    mvals[m+1]= m;

    

    if(m>0){
        dtold=timevals[timevals.n-1]-timevals[timevals.n-2];
    }
    if(m>1){
        dtold2=timevals[timevals.n-2]-timevals[timevals.n-3];
    }
    if(m>2){
        dtold3=timevals[timevals.n-3]-timevals[timevals.n-4];
    }




  

    if(dt>dtmin && t<tfinal[tfinal.n-1]){ //If time is past the final breakpoint, don't need to enter this. 
        for(int ii=iBP; ii<tfinal.n; ii++){
            if(t<tfinal[ii]){
                ibreak=ii;
                iBP=ii-1;
                break;
            }
        }

        if(t + 2*dt>tfinal[ibreak]){
            while(t+2*dt>tfinal[ibreak]){
                if((abs(Iapp(t+dt)-Iapp(t))/abs(Iapp(t)+1e-10))<=0.01 && (t + dt<=tfinal[ibreak])){ //If the applied current changes by 1% or less relative to its current value, go with that value.
                    break;                                              //Will prevent dt from shrinking all the way to dtmin unnecessarily.
                }
                dt=0.5*dt;
                if(dt<dtmin){
                    dt=dtmin;
                    break;
                }

               
            }
        }
    }

    t=t+dt;


    cout<<"Cell voltage="<<VOLT<<endl;
    cout<<"m="<<m<<endl;
    cout<<"t="<<t<<endl;
    cout<<"---"<<endl;

    K2=0; //For dealing with errors, reset to zero at start of time step
    DT=dt;
    int i=-1;
    err1=1; //Reset the error to an arbitrary value larger than the tolerance so the Newton loop isn't immediately cancelled.
  
    du1=0;
    du2=0;
    dphi=0;

   

    //PREDICTOR

    //Interpolate latest solutions and then extrapolate to obtain closer intial guess (predictor)
    if(m>2){
     uin1 = UIN1[Nstore-3]*(((t-timevals[timevals.n-2])*(t-timevals[timevals.n-1]))/((timevals[timevals.n-3]-timevals[timevals.n-2])*(timevals[timevals.n-3]-timevals[timevals.n-1]))) + UIN1[Nstore-2]*(((t-timevals[timevals.n-3])*(t-timevals[timevals.n-1]))/((timevals[timevals.n-2]-timevals[timevals.n-3])*(timevals[timevals.n-2]-timevals[timevals.n-1]))) + UIN1[Nstore-1]*(((t-timevals[timevals.n-3])*(t-timevals[timevals.n-2]))/((timevals[timevals.n-1]-timevals[timevals.n-3])*(timevals[timevals.n-1]-timevals[timevals.n-2])));
    }

    if(m>2){
     uin2 = UIN2[Nstore-3]*(((t-timevals[timevals.n-2])*(t-timevals[timevals.n-1]))/((timevals[timevals.n-3]-timevals[timevals.n-2])*(timevals[timevals.n-3]-timevals[timevals.n-1]))) + UIN2[Nstore-2]*(((t-timevals[timevals.n-3])*(t-timevals[timevals.n-1]))/((timevals[timevals.n-2]-timevals[timevals.n-3])*(timevals[timevals.n-2]-timevals[timevals.n-1]))) + UIN2[Nstore-1]*(((t-timevals[timevals.n-3])*(t-timevals[timevals.n-2]))/((timevals[timevals.n-1]-timevals[timevals.n-3])*(timevals[timevals.n-1]-timevals[timevals.n-2])));
    }
    
    if(m>2){
     CpbO = CPBO[Nstore-3]*(((t-timevals[timevals.n-2])*(t-timevals[timevals.n-1]))/((timevals[timevals.n-3]-timevals[timevals.n-2])*(timevals[timevals.n-3]-timevals[timevals.n-1]))) + CPBO[Nstore-2]*(((t-timevals[timevals.n-3])*(t-timevals[timevals.n-1]))/((timevals[timevals.n-2]-timevals[timevals.n-3])*(timevals[timevals.n-2]-timevals[timevals.n-1]))) + CPBO[Nstore-1]*(((t-timevals[timevals.n-3])*(t-timevals[timevals.n-2]))/((timevals[timevals.n-1]-timevals[timevals.n-3])*(timevals[timevals.n-1]-timevals[timevals.n-2])));
     CpbO=(0.5+0.5*tanh(k*(CpbO-DELTA)))*CpbO;
    }

    if(m>2){
     CbpbO2 = CPBO2[Nstore-3]*(((t-timevals[timevals.n-2])*(t-timevals[timevals.n-1]))/((timevals[timevals.n-3]-timevals[timevals.n-2])*(timevals[timevals.n-3]-timevals[timevals.n-1]))) + CPBO2[Nstore-2]*(((t-timevals[timevals.n-3])*(t-timevals[timevals.n-1]))/((timevals[timevals.n-2]-timevals[timevals.n-3])*(timevals[timevals.n-2]-timevals[timevals.n-1]))) + CPBO2[Nstore-1]*(((t-timevals[timevals.n-3])*(t-timevals[timevals.n-2]))/((timevals[timevals.n-1]-timevals[timevals.n-3])*(timevals[timevals.n-1]-timevals[timevals.n-2])));
     CbpbO2=(0.5+0.5*tanh(k*(CbpbO2-DELTA)))*CbpbO2;
    }

    if(m>2){
